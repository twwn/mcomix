#: mcomix/preferences_dialog.py:333
msgid "Slideshow"
msgstr "Presentación de imaxes"

#: mcomix/preferences_dialog.py:335
msgid "Slideshow delay (in seconds):"
msgstr "Demora da presentación (en segundos):"

#: mcomix/preferences_dialog.py:340
