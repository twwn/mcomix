#. archive's ComicInfo.xml gives it.
#: mcomix/properties_dialog.py:166
msgid "Number"
msgstr "Numéro"

#: mcomix/properties_dialog.py:167
msgid "Title"
msgstr "Titre"

#: mcomix/properties_dialog.py:168
msgid "Writer"
msgstr "Scénariste"

# Do not remove extra blank space at the end of the fr translation. It is needed before ":"
#: mcomix/properties_dialog.py:234
msgid "Accessed"
msgstr "Accédé le "

# Do not remove extra blank space at the end of the fr translation. It is needed before ":"
#: mcomix/properties_dialog.py:236
