msgid_plural "%d books could not be moved to the trash."
msgstr[0] "%d könyvet nem sikerült a Kukába helyezni."
msgstr[1] "%d könyvet nem sikerült a Kukába helyezni."

#: mcomix/file_actions.py:1499
