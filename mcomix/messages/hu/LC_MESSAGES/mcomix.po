msgstr "Cím"

#: mcomix/properties_dialog.py:223
msgid "Writer"
msgstr "Író"

#. TRANSLATORS: Which volume of its series a comic is, as the
#. archive's ComicInfo.xml gives it.
#: mcomix/properties_dialog.py:226
