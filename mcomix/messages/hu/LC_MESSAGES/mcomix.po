msgstr "Azonos méretarány előnyben részesítése"

#: mcomix/preferences_dialog.py:644
msgid "Prefer same size"
msgstr "Azonos méret előnyben részesítése"

#: mcomix/preferences_dialog.py:645
msgid "Fit to same size"
msgstr "Azonos mérethez igazítás"

#: mcomix/preferences_dialog.py:652
msgid "Maintain relative size or fit to same size."
msgstr "Megtartja a viszonylagos méretet, vagy azonos mérethez igazít."

#: mcomix/preferences_dialog.py:666 mcomix/preferences_dialog.py:711
msgid "No sorting"
msgstr "Nincs rendezés"

#: mcomix/preferences_dialog.py:667
msgid "File name"
msgstr "Fájlnév"

#: mcomix/preferences_dialog.py:668
msgid "File name (GLib)"
msgstr "Fájlnév (GLib)"

