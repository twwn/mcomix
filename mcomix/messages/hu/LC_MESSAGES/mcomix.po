msgid "There is no trash for this folder, so it cannot be restored."
msgstr "Ehhez a mappához nincs Kuka, ezért nem lehet visszaállítani."

#: mcomix/file_actions.py:1343
#, python-format
msgid "Delete \"%s\"?"
msgstr "Törli ezt: „%s”?"

#: mcomix/file_actions.py:1344
msgid "The file is moved to the trash."
msgstr "A fájl a Kukába kerül."

#: mcomix/file_actions.py:1346
msgid "_Move to Trash"
msgstr "Á_thelyezés a Kukába"

