msgstr "Kötet"

#: mcomix/properties_dialog.py:227
msgid "Year"
msgstr "Év"

#. TRANSLATORS: Who drew the comic: ComicInfo.xml's Penciller.
#: mcomix/properties_dialog.py:229
msgid "Artist"
msgstr "Rajzoló"

#: mcomix/properties_dialog.py:230
msgid "Publisher"
msgstr "Kiadó"

#: mcomix/properties_dialog.py:262
msgid "Accessed"
msgstr "Utolsó elérés"

#: mcomix/properties_dialog.py:264
msgid "Modified"
msgstr "Módosítva"

#: mcomix/properties_dialog.py:273
msgid "Permissions"
msgstr "Jogosultságok"

#: mcomix/properties_dialog.py:274
msgid "Owner"
msgstr "Tulajdonos"

#: mcomix/recent.py:152
msgid "No entries found"
msgstr "Nincs találat"

#: mcomix/recent.py:159
msgid "_Clear List"
msgstr "_Lista törlése"

#: mcomix/rename_dialog.py:115
msgid "S_wap the names"
msgstr "Nevek _cseréje"

#: mcomix/rename_dialog.py:116
msgid "_Replace"
msgstr "C_sere"

#: mcomix/run.py:56
msgid "[OPTION...] [PATH]"
msgstr "[KAPCSOLÓ...] [ÚTVONAL]"

#: mcomix/run.py:57
msgid "View images and comic book archives."
msgstr "Képek és képregényarchívumok megtekintése."

#: mcomix/run.py:60
msgid "Show this help and exit."
msgstr "Megjeleníti ezt a súgót, majd kilép."

#: mcomix/run.py:62
msgid "Start the application in slideshow mode."
msgstr "Az alkalmazás indítása diavetítés módban."

#: mcomix/run.py:64
msgid "Show the library on startup."
msgstr "A könyvtár megjelenítése induláskor."

#: mcomix/run.py:67
msgid "Show the version number and exit."
msgstr "Megjeleníti a verziószámot, majd kilép."

#: mcomix/run.py:69
msgid "Temporarily override the interface language."
msgstr "Ideiglenesen felülírja a felület nyelvét."

