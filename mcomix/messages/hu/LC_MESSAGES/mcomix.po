msgstr "A kontraszt _automatikus beállítása"

#: mcomix/enhance_dialog.py:118
msgid ""
"Automatically adjust contrast (both lightness and darkness), separately for "
"each colour band."
msgstr ""
"A kontraszt automatikus beállítása (mind a világosságot és a  sötétséget is) "
"minden egyes színsávhoz."

#: mcomix/enhance_dialog.py:123 mcomix/ui.py:585
msgid "_Invert image colors"
msgstr "A kép színeinek _invertálása"

#: mcomix/enhance_dialog.py:125
