msgstr "Parancsok s_zerkesztése"

#: mcomix/openwith.py:164
#, python-format
msgid "'%s' is disabled for archives."
msgstr "A(z) „%s” archívumoknál le van tiltva."

#: mcomix/openwith.py:208
#, python-format
