#: mcomix/preferences_dialog.py:139
msgid "Escape key closes program"
msgstr "Az Esc billentyű bezárja a programot"

#: mcomix/preferences_dialog.py:140
msgid ""
"When active, the ESC key closes the program, instead of only disabling "
"fullscreen mode."
msgstr ""
"Ha be van kapcsolva, az Esc billentyű bezárja a programot ahelyett, hogy "
"csak a teljes képernyős módból lépne ki."

#: mcomix/preferences_dialog.py:143
msgid "Background"
msgstr "Háttér"

#: mcomix/preferences_dialog.py:146
msgid "Use this colour as background:"
msgstr "Ez a szín legyen a háttér:"

#: mcomix/preferences_dialog.py:147
msgid "Always use this selected colour as the background colour."
msgstr "Mindig a kiválasztott szín legyen a háttérszín."

#: mcomix/preferences_dialog.py:148 mcomix/preferences_dialog.py:159
msgid "Use dynamic background colour"
msgstr "Dinamikus háttérszín használata"

#: mcomix/preferences_dialog.py:150
msgid "Automatically pick a background colour that fits the viewed image."
msgstr ""
"A program magától válasszon egy háttérszínt, ami az aktuális képhez illik."

#: mcomix/preferences_dialog.py:157
msgid "Use this colour as the thumbnail background:"
msgstr "Ez a szín legyen a bélyegképek háttere:"

#: mcomix/preferences_dialog.py:158
msgid "Always use this selected colour as the thumbnail background colour."
msgstr "Mindig a kiválasztott szín legyen a bélyegképek háttérszíne."

#: mcomix/preferences_dialog.py:161
msgid ""
"Automatically use the colour that fits the viewed image for the thumbnail "
"background."
msgstr ""
"A bélyegképek hátteréhez automatikusan a megtekintett képhez illő színt "
"használja."

#: mcomix/preferences_dialog.py:166
msgid "Show page numbers on thumbnails"
msgstr "Oldalszámok megjelenítése a bélyegképeken"

#: mcomix/preferences_dialog.py:169
msgid "Thumbnail size (in pixels):"
msgstr "Bélyegképek mérete (képpontban):"

#: mcomix/preferences_dialog.py:174
msgid "Transparency"
msgstr "Átlátszóság"

#: mcomix/preferences_dialog.py:177
msgid "Use checkered background for transparent images"
msgstr "Kockás háttér használata az átlátszó képekhez"

#: mcomix/preferences_dialog.py:179
msgid ""
"Use a grey checkered background for transparent images. If this preference "
"is unset, the background is plain white instead."
msgstr ""
"Az átlátszó képek háttere tarka legyen (szürke). Ha ez a beállítás nem "
"aktív, akkor a háttérszín teljesen fehér lesz."

#: mcomix/preferences_dialog.py:192
msgid "Use smart scrolling"
msgstr "Intelligens görgetés használata"

#: mcomix/preferences_dialog.py:194
msgid ""
"With this preference set, the space key and mouse wheel do not only scroll "
"down or up, but also sideways and so try to follow the natural reading order "
"of the comic book."
msgstr ""
"Ha ez a beállítás be van kapcsolva, a szóköz és az egérgörgő nemcsak lefelé "
"és felfelé görget, hanem oldalra is, így követve a képregény természetes "
"olvasási sorrendjét."

#: mcomix/preferences_dialog.py:199
msgid "Flip pages when scrolling off the edges of the page"
msgstr "Lapozás, ha a görgetés túlfut az oldal szélén"

#: mcomix/preferences_dialog.py:201
msgid ""
"Flip pages when scrolling \"off the page\" with the scroll wheel or with the "
"arrow keys. It takes n consecutive \"steps\" with the scroll wheel or the "
"arrow keys for the pages to be flipped."
msgstr ""
"Lapoz, amikor a görgetés az egérgörgővel vagy a nyílbillentyűkkel „lefut az "
"oldalról”. A lapozáshoz n egymást követő „lépés” kell a görgővel vagy a "
"nyílbillentyűkkel."

#: mcomix/preferences_dialog.py:204
msgid "Automatically open the next archive"
msgstr "A következő archívum automatikus megnyitása"

#: mcomix/preferences_dialog.py:206
msgid ""
"Automatically open the next archive in the directory when flipping past the "
"last page, or the previous archive when flipping past the first page."
msgstr ""
"Automatikusan megnyitja a következő arhívumot, ha az aktuális utolsó lapját "
"elhagyjuk, illetve az előzőt, ha az első kép elé lépünk."

#: mcomix/preferences_dialog.py:209
msgid "Automatically open next directory"
msgstr "A következő mappa automatikus megnyitása"

#: mcomix/preferences_dialog.py:211
msgid ""
"Automatically open the first file in the next sibling directory when "
"flipping past the last page of the last file in a directory, or the previous "
"directory when flipping past the first page of the first file."
msgstr ""
"Automatikusan megnyitja a következő testvérmappa első fájlját, amikor a "
"mappa utolsó fájljának utolsó oldalán továbblapoz, illetve az előző mappát, "
"amikor az első fájl első oldaláról visszalapoz."

#: mcomix/preferences_dialog.py:214
msgid "Open first file when navigating to previous archive"
msgstr "Az első fájl megnyitása az előző archívumra lépéskor"

#: mcomix/preferences_dialog.py:216
msgid ""
"Automatically open the first file of the previous archive when navigating to "
"it, instead of opening the last file of the previous archive."
msgstr ""
"Az előző archívumra lépéskor automatikusan annak első fájlját nyitja meg az "
"utolsó helyett."

#: mcomix/preferences_dialog.py:219
msgid "Open first file when navigating to previous directory"
msgstr "Az első fájl megnyitása az előző mappára lépéskor"

#: mcomix/preferences_dialog.py:221
msgid ""
"Automatically open the first file of the previous directory when navigating "
"to it, instead of opening the last file of the previous directory."
msgstr ""
"Az előző mappára lépéskor automatikusan annak első fájlját nyitja meg az "
"utolsó helyett."

#: mcomix/preferences_dialog.py:223
msgid "Number of pixels to scroll per arrow key press:"
msgstr "Görgetés képpontban a nyílbillentyűk egy lenyomására:"

#: mcomix/preferences_dialog.py:227
msgid "Set the number of pixels to scroll on a page when using the arrow keys."
msgstr ""
"Beállítja, hány képpontot görget az oldalon a nyílbillentyűk használata."

#: mcomix/preferences_dialog.py:229
msgid "Number of pixels to scroll per mouse wheel turn:"
msgstr "Görgetés képpontban az egérgörgő egy fordulatára:"

#: mcomix/preferences_dialog.py:233
msgid "Set the number of pixels to scroll on a page when using a mouse wheel."
msgstr "Beállítja, hány képpontot görget az oldalon az egérgörgő használata."

#: mcomix/preferences_dialog.py:235
msgid "Fraction of page to scroll per space key press (in percent):"
msgstr "Az oldal görgetett hányada a szóköz egy lenyomására (százalékban):"

#: mcomix/preferences_dialog.py:240
msgid ""
"Sets the percentage by which the page will be scrolled down or up when the "
"space key is pressed."
msgstr ""
"Beállítja, hány százalékot görög az oldal lefelé vagy felfelé a szóköz "
"lenyomására."

#: mcomix/preferences_dialog.py:243
msgid "Number of \"steps\" to take before flipping the page:"
msgstr "A lapozás előtt megteendő „lépések” száma:"

#: mcomix/preferences_dialog.py:247
msgid ""
"Set the number of \"steps\" needed to flip to the next or previous page.  "
"Less steps will allow for very fast page turning but you might find yourself "
"accidentally turning pages."
msgstr ""
"Beállítja, hány „lépés” kell a következő vagy az előző oldalra lapozáshoz. "
"Kevesebb lépéssel nagyon gyorsan lehet lapozni, de könnyebb véletlenül is "
"megtenni."

#: mcomix/preferences_dialog.py:252
msgid "Flip two pages in double page mode"
msgstr "Két oldal lapozása kétoldalas módban"

#: mcomix/preferences_dialog.py:254
msgid ""
