msgstr "Nem sikerült futtatni a(z) %(cmdlabel)s parancsot: %(exception)s"

#: mcomix/openwith.py:259
msgid "Command line is empty."
msgstr "A parancssor üres."

#: mcomix/openwith.py:324
msgid "Incomplete escape sequence. For a literal '%', use '%%'."
msgstr ""
"Hiányos escape-szekvencia. Magához a „%” karakterhez használjon „%%”-ot."

#: mcomix/openwith.py:328
msgid "Incomplete quote sequence. For a literal '\"', use '%\"'."
msgstr "Lezáratlan idézőjel. Magához a „\"” karakterhez használjon „%\"”-ot."

#: mcomix/openwith.py:342 mcomix/openwith.py:355 mcomix/openwith.py:387
msgid "File-related variables can only be used for files."
msgstr "A fájlokra vonatkozó változók csak fájloknál használhatók."

#: mcomix/openwith.py:346
msgid "Archive-related variables can only be used for archives."
msgstr "Az archívumokra vonatkozó változók csak archívumoknál használhatók."

#: mcomix/openwith.py:405
#, python-format
msgid "Invalid escape sequence: %%%s"
msgstr "Érvénytelen escape-szekvencia: %%%s"

#: mcomix/openwith.py:416
msgid "Edit external commands"
msgstr "Külső parancsok szerkesztése"

#: mcomix/openwith.py:427
