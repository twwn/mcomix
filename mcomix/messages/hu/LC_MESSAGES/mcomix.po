msgid "Delete it"
msgstr "Törlés"

#: mcomix/message_dialog.py:79
msgid "Bookmarking a page in a book that has bookmarks already:"
msgstr ""
"Olyan könyv egy oldalának könyvjelzőzésekor, amelyben már van könyvjelző:"

#: mcomix/message_dialog.py:80
msgid "Replace the existing bookmark"
msgstr "A meglévő könyvjelző cseréje"

#: mcomix/message_dialog.py:81
msgid "Keep both bookmarks"
msgstr "Mindkét könyvjelző megtartása"

#: mcomix/message_dialog.py:83
msgid "Deleting books that are removed from the library:"
msgstr "A könyvtárból eltávolított könyvek törlésekor:"

#: mcomix/message_dialog.py:84
msgid "Delete them"
msgstr "Törlés"

#: mcomix/message_dialog.py:86
msgid "Changing the pages of the book being read:"
msgstr "Az olvasott könyv oldalainak módosítása:"

#: mcomix/message_dialog.py:87
msgid "Write the archive again at once"
msgstr "Az archívum azonnali újraírása"

#: mcomix/message_dialog.py:88
msgid "Leave the archive as it is"
msgstr "Az archívum változatlanul hagyása"

#: mcomix/message_dialog.py:90
msgid "Leaving a book with pages still picked out:"
msgstr "Olyan könyv elhagyása, amelyben oldalak vannak kijelölve:"

#: mcomix/message_dialog.py:91
msgid "Remove them and write the archive"
msgstr "Eltávolításuk és az archívum írása"

#: mcomix/message_dialog.py:92
msgid "Leave the book as it is"
msgstr "A könyv változatlanul hagyása"

#: mcomix/message_dialog.py:94
msgid "Deleting a file that is bookmarked:"
msgstr "Könyvjelzőkkel ellátott fájl törlésekor:"

#: mcomix/message_dialog.py:95
msgid "Remove its bookmarks"
msgstr "Könyvjelzőinek eltávolítása"

#: mcomix/message_dialog.py:96
msgid "Keep its bookmarks"
msgstr "Könyvjelzőinek megtartása"

#: mcomix/message_dialog.py:149
msgid "Do not ask again."
msgstr "Ne kérdezze újra."

#: mcomix/move_menu.py:116
msgid "Moved to before"
msgstr "Legutóbbi célmappák"

#: mcomix/move_menu.py:117
msgid "From bookmarks"
msgstr "A könyvjelzőkből"

#: mcomix/move_menu.py:118
msgid "Opened before"
msgstr "Nemrég megnyitott"

#: mcomix/move_menu.py:137
