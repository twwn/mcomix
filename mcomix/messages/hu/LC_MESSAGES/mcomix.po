msgid ""
"Set the maximum number of concurrent threads for formats that support it."
msgstr ""
"Beállítja az egyidejű szálak legnagyobb számát az ezt támogató formátumokhoz."

#: mcomix/preferences_dialog.py:388
msgid "Maximum number of concurrent thumbnail threads:"
msgstr "Egyidejű bélyegképszálak legnagyobb száma:"

#: mcomix/preferences_dialog.py:392
msgid ""
"Set the maximum number of concurrent threads used to generate thumbnails. "
"Takes effect the next time MComix is started."
msgstr ""
"Beállítja a bélyegképek készítéséhez használt egyidejű szálak legnagyobb "
"számát. Az MComix következő indításakor lép érvénybe."

#: mcomix/preferences_dialog.py:395
msgid "Store thumbnails for opened files"
msgstr "A megnyitott fájlok bélyegképeinek tárolása"

#: mcomix/preferences_dialog.py:397
msgid ""
"Store thumbnails for opened files according to the freedesktop.org "
"specification. These thumbnails are shared by many other applications, such "
"as most file managers."
msgstr ""
"A megnyitott fájlok bélyegképei legyenek eltárolva a freedesktop.org "
"előírásainak megfelelően. Ezen bélyegképeket más alkalmazások, például a "
"legtöbb fájlkezelő is használhatja majd."

#: mcomix/preferences_dialog.py:399
msgid "Maximum number of pages to store in the cache:"
msgstr "A gyorsítótárban tárolt oldalak legnagyobb száma:"

#: mcomix/preferences_dialog.py:403
msgid ""
"Set the max number of pages to cache. A value of -1 will cache the entire "
"archive."
msgstr ""
"Beállítja a gyorsítótárazott oldalak legnagyobb számát. A -1 érték az egész "
"archívumot gyorsítótárazza."

#: mcomix/preferences_dialog.py:405
msgid "Magnifying Lens"
msgstr "Nagyító"

#: mcomix/preferences_dialog.py:407
msgid "Magnifying lens size (in pixels):"
msgstr "A nagyító mérete (képpontban):"

#: mcomix/preferences_dialog.py:411
msgid ""
"Set the size of the magnifying lens. It is a square with a side of this many "
"pixels."
msgstr ""
"A nagyító lencse méreteinek megadása. Ez egy négyzet, aminek az oldalai "
"megadott pixelszámúak."

#: mcomix/preferences_dialog.py:413
msgid "Magnification factor:"
msgstr "Nagyítási tényező:"

#: mcomix/preferences_dialog.py:417
msgid "Set the magnification factor of the magnifying lens."
msgstr "A nagyító nagyítási tényezőjének beállítása."

#: mcomix/preferences_dialog.py:421
msgid "Comment extensions:"
msgstr "Megjegyzésfájlok kiterjesztései:"

