msgstr "Nem kerül a Kukába, és nem lehet visszaállítani."

#: mcomix/file_actions.py:1384 mcomix/library/book_area.py:1377
#, python-format
msgid "Delete \"%s\" permanently?"
msgstr "Véglegesen törli ezt: „%s”?"

