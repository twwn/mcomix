#: mcomix/preferences_dialog.py:369
msgid ""
"Store thumbnails for opened files according to the freedesktop.org "
"specification. These thumbnails are shared by many other applications, such "
"as most file managers."
msgstr ""
"A megnyitott fájlok bélyegképei legyenek eltárolva a freedesktop.org "
"előírásainak megfelelően. Ezen bélyegképeket más alkalmazások, például a "
"legtöbb fájlkezelő is használhatja majd."

#: mcomix/preferences_dialog.py:371
msgid "Maximum number of pages to store in the cache:"
msgstr "A gyorsítótárban tárolt oldalak legnagyobb száma:"

#: mcomix/preferences_dialog.py:374
