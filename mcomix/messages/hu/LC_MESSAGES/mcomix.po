msgstr "Ez egy elválasztó álparancs."

#: mcomix/openwith.py:531
#, python-format
msgid "\"%s\" does not have a valid working directory."
msgstr "A(z) „%s” nem rendelkezik érvényes munkamappával."

#: mcomix/openwith.py:534
#, python-format
msgid "\"%s\" does not appear to have a valid executable."
msgstr "Úgy tűnik, a(z) „%s” nem rendelkezik érvényes futtatható fájllal."

#: mcomix/openwith.py:543
msgid "Command label"
msgstr "A parancs címkéje"

#: mcomix/openwith.py:633
msgid "Preview:"
msgstr "Előnézet:"

#: mcomix/openwith.py:641
#, python-format
msgid ""
"Please refer to the <a href=\"%s\">external command documentation</a> for a "
"list of usable variables and other hints."
msgstr ""
"A használható változók listájáért és további tudnivalókért lásd a <a "
"href=\"%s\">külső parancsok dokumentációját</a>."

#: mcomix/openwith.py:654
msgid "Label"
msgstr "Címke"

#: mcomix/openwith.py:656
msgid "Working directory"
msgstr "Munkamappa"

#: mcomix/openwith.py:663
msgid "Disabled in archives"
msgstr "Archívumokban letiltva"

#: mcomix/openwith.py:733
msgid "Save changes to commands?"
msgstr "Menti a parancsok módosításait?"

#: mcomix/openwith.py:734
msgid ""
"You have made changes to the list of external commands that have not been "
"saved yet. Press \"Yes\" to save all changes, or \"No\" to discard them."
msgstr ""
"A külső parancsok listáján még nem mentett módosítások vannak. Az „Igen” "
"mindet menti, a „Nem” eldobja őket."

#: mcomix/page_image.py:279
#, python-format
msgid "! Could not draw the next frame: %s"
msgstr "! Nem sikerült kirajzolni a következő képkockát: %s"

