#, python-format
msgid "\"%s\" does not have a valid working directory."
msgstr "«%s» не має правильного робочого каталогу."

#: mcomix/openwith.py:436
#, python-format
msgid "\"%s\" does not appear to have a valid executable."
msgstr "Схоже, «%s» не має правильного виконуваного файла."

#: mcomix/openwith.py:445
msgid "Command label"
msgstr "Підпис команди"

#: mcomix/openwith.py:536
msgid "Preview:"
msgstr "Перегляд:"

#: mcomix/openwith.py:544
#, python-format
msgid ""
"Please refer to the <a href=\"%s\">external command documentation</a> for a "
"list of usable variables and other hints."
msgstr ""
"Перелік доступних змінних та інші підказки дивіться в <a "
"href=\"%s\">документації із зовнішніх команд</a>."

#: mcomix/openwith.py:557
msgid "Label"
msgstr "Мітка"

#: mcomix/openwith.py:559
msgid "Working directory"
msgstr "Робочий каталог"

#: mcomix/openwith.py:566
msgid "Disabled in archives"
msgstr "Вимкнено в архівах"

#: mcomix/openwith.py:616
msgid "Save changes to commands?"
msgstr "Зберегти зміни в командах?"

#: mcomix/openwith.py:617
msgid ""
"You have made changes to the list of external commands that have not been "
"saved yet. Press \"Yes\" to save all changes, or \"No\" to discard them."
msgstr ""
"У переліку зовнішніх команд є незбережені зміни. Натисніть «Так», щоб "
"зберегти всі зміни, або «Ні», щоб відмовитися від них."

#: mcomix/page_image.py:243
#, python-format
msgid "! Could not draw the next frame: %s"
msgstr "! Не вдалося намалювати наступний кадр: %s"

#: mcomix/pageselect.py:29 mcomix/ui.py:462
msgid "Go to page..."
msgstr "Перейти до сторінки..."

#: mcomix/pageselect.py:31 mcomix/ui.py:500 mcomix/ui.py:501
msgid "_Go"
msgstr "Пере_йти"

#: mcomix/pageselect.py:52
#, python-format
msgid " of %s"
msgstr " з %s"

#: mcomix/preferences_dialog.py:96
msgid "Appearance"
msgstr "Вигляд"

#: mcomix/preferences_dialog.py:97
msgid "Behaviour"
msgstr "Поведінка"

#: mcomix/preferences_dialog.py:99
msgid "Display"
msgstr "Показ"

#: mcomix/preferences_dialog.py:100
msgid "Advanced"
msgstr "Додатково"

#: mcomix/preferences_dialog.py:117
msgid "Shortcuts"
msgstr "Скорочення"

#: mcomix/preferences_dialog.py:133
msgid "Language (needs restart):"
msgstr "Мова (потребує перезапуску):"

#: mcomix/preferences_dialog.py:136
msgid "Theme:"
msgstr "Тема:"

#: mcomix/preferences_dialog.py:139
msgid "Background"
msgstr "Тло"

#: mcomix/preferences_dialog.py:142
msgid "Use this colour as background:"
msgstr "Вживати цей колір як тло:"

#: mcomix/preferences_dialog.py:143
msgid "Always use this selected colour as the background colour."
msgstr "Завжди використовувати обраний колір, як колір тла."

#: mcomix/preferences_dialog.py:144 mcomix/preferences_dialog.py:155
msgid "Use dynamic background colour"
msgstr "Вживати динамічний колір тла"

#: mcomix/preferences_dialog.py:146
msgid "Automatically pick a background colour that fits the viewed image."
msgstr ""
"Автоматично обирати колір тла, який підходить до зображення, що "
"відображається."

#: mcomix/preferences_dialog.py:153
msgid "Use this colour as the thumbnail background:"
msgstr "Вживати цей колір як тло мініатюр:"

#: mcomix/preferences_dialog.py:154
msgid "Always use this selected colour as the thumbnail background colour."
msgstr "Завжди вживати вибраний колір як колір тла мініатюр."

#: mcomix/preferences_dialog.py:157
msgid ""
"Automatically use the colour that fits the viewed image for the thumbnail "
"background."
msgstr ""
"Автоматично вживати для тла мініатюр колір, що пасує до переглядуваного "
"зображення."

#: mcomix/preferences_dialog.py:162
msgid "Show page numbers on thumbnails"
msgstr "Показувати номери сторінок на мініатюрах"

#: mcomix/preferences_dialog.py:165
msgid "Thumbnail size (in pixels):"
msgstr "Розмір мініатюр (у пікселях):"

#: mcomix/preferences_dialog.py:170
msgid "Transparency"
msgstr "Прозорість"

#: mcomix/preferences_dialog.py:173
msgid "Use checkered background for transparent images"
msgstr "Вживати шахове тло для прозорих зображень"

#: mcomix/preferences_dialog.py:175
msgid ""
"Use a grey checkered background for transparent images. If this preference "
"is unset, the background is plain white instead."
msgstr ""
"Використовувати сірий клітчастий фон для прозорих зображень. Якщо цей "
"параметр не встановленно, для тла буде використовуватися білий колір."

#: mcomix/preferences_dialog.py:185
msgid "Files"
msgstr "Файли"

#: mcomix/preferences_dialog.py:188
msgid "Automatically open the last viewed file on startup"
msgstr "Автоматично відкривати останній переглянутий файл при запуску"

#: mcomix/preferences_dialog.py:190
msgid ""
"Automatically open, on startup, the file that was open when MComix was last "
"closed."
msgstr ""
"При запуску автоматично відкриває файл, який був відкритий при останньому "
"закритті MComix."

#: mcomix/preferences_dialog.py:193
msgid "Open the library on startup"
msgstr "Відкривати бібліотеку під час запуску"

#: mcomix/preferences_dialog.py:196
msgid "Store information about recently opened files:"
msgstr "Зберігати відомості про нещодавно відкриті файли:"

#: mcomix/preferences_dialog.py:199
msgid "Save As opens at the last directory saved into"
msgstr "«Зберегти як» відкривається в каталозі, куди зберігали востаннє"

#: mcomix/preferences_dialog.py:201
msgid ""
"Open the Save As dialog at the directory in which the last file was saved."
msgstr ""
"Відкриває вікно «Зберегти як» у каталозі, де було збережено останній файл."

#: mcomix/preferences_dialog.py:204
msgid "Save an edited archive in the format it was opened in"
msgstr "Зберігати змінений архів у форматі, в якому його було відкрито"

#: mcomix/preferences_dialog.py:206
msgid ""
"Write an edited archive back as a ZIP, a tar, a 7z or a RAR, whichever it "
"was read as. The last two need the 7z and rar programs, which MComix does "
"not install; a format it cannot write is saved as a ZIP."
msgstr ""
"Записувати змінений архів назад як ZIP, tar, 7z або RAR — залежно від того, "
"як його було прочитано. Для двох останніх потрібні програми 7z і rar, які "
"MComix не встановлює; формат, який неможливо записати, зберігається як ZIP."

#: mcomix/preferences_dialog.py:208
msgid "Prompts answered for good"
msgstr "Питання, на які відповіли раз і назавжди"

#: mcomix/preferences_dialog.py:227
msgid "Use smart scrolling"
msgstr "Вживати розумне прокручування"

#: mcomix/preferences_dialog.py:229
msgid ""
"With this preference set, the space key and mouse wheel do not only scroll "
"down or up, but also sideways and so try to follow the natural reading order "
"of the comic book."
msgstr ""
"Коли це увімкнено, пробіл і коліщатко миші прокручують не лише вниз чи "
"вгору, а й убік, намагаючись дотримуватися природного порядку читання "
"коміксу."

#: mcomix/preferences_dialog.py:234
msgid "Flip pages when scrolling off the edges of the page"
msgstr "Гортати сторінки при прокручуванні за край сторінки"

#: mcomix/preferences_dialog.py:236
msgid ""
"Flip pages when scrolling \"off the page\" with the scroll wheel or with the "
"arrow keys. It takes n consecutive \"steps\" with the scroll wheel or the "
"arrow keys for the pages to be flipped."
msgstr ""
"Гортає сторінки при прокручуванні «за сторінку» коліщатком миші або "
"клавішами зі стрілками. Щоб сторінку було перегорнуто, потрібно n "
"послідовних «кроків» коліщатком або стрілками."

#: mcomix/preferences_dialog.py:239
msgid "Flip pages with a left click"
msgstr "Гортати сторінки клацанням лівою кнопкою"

#: mcomix/preferences_dialog.py:241
msgid ""
"A left click on the page turns to the next one. Clicks with SHIFT or ALT "
"turn pages either way."
msgstr ""
"Клацання лівою кнопкою на сторінці переходить до наступної. Клацання з SHIFT "
"або ALT гортають у будь-якому разі."

#: mcomix/preferences_dialog.py:244
msgid "Skip pages that cannot be shown"
msgstr "Пропускати сторінки, які не можна показати"

#: mcomix/preferences_dialog.py:246
msgid ""
"Turn past a page whose image is damaged or cannot be read, instead of "
"showing the broken-image icon in its place."
msgstr ""
"Пропускати сторінку, зображення якої пошкоджене або не читається, замість "
"того щоб показувати на її місці значок пошкодженого зображення."

#: mcomix/preferences_dialog.py:248
msgid "Number of pixels to scroll per arrow key press:"
msgstr "Кількість пікселів прокручування на одне натискання стрілки:"

#: mcomix/preferences_dialog.py:252
msgid "Set the number of pixels to scroll on a page when using the arrow keys."
msgstr ""
"Задає, на скільки пікселів прокручується сторінка при вживанні клавіш зі "
"стрілками."

#: mcomix/preferences_dialog.py:254
msgid "Number of pixels to scroll per mouse wheel turn:"
msgstr "Кількість пікселів прокручування на один оберт коліщатка:"

#: mcomix/preferences_dialog.py:258
msgid "Set the number of pixels to scroll on a page when using a mouse wheel."
msgstr ""
"Задає, на скільки пікселів прокручується сторінка при вживанні коліщатка "
"миші."

#: mcomix/preferences_dialog.py:260
msgid "Fraction of page to scroll per space key press (in percent):"
msgstr ""
"Частина сторінки, що прокручується на натискання пробілу (у відсотках):"

#: mcomix/preferences_dialog.py:265
msgid ""
"Sets the percentage by which the page will be scrolled down or up when the "
"space key is pressed."
msgstr ""
"Задає, на скільки відсотків сторінка прокручується вниз або вгору при "
"натисканні пробілу."

#: mcomix/preferences_dialog.py:268
msgid "Number of \"steps\" to take before flipping the page:"
msgstr "Кількість «кроків» перед гортанням сторінки:"

#: mcomix/preferences_dialog.py:272
msgid ""
"Set the number of \"steps\" needed to flip to the next or previous page.  "
"Less steps will allow for very fast page turning but you might find yourself "
"accidentally turning pages."
msgstr ""
"Задає кількість «кроків», потрібних для переходу на наступну чи попередню "
"сторінку. Менша кількість дозволяє гортати дуже швидко, але легше зробити це "
"випадково."

#: mcomix/preferences_dialog.py:274
msgid "Milliseconds to ignore the wheel after it turns a page:"
msgstr "Мілісекунди, протягом яких коліщатко ігнорується після гортання:"

#: mcomix/preferences_dialog.py:278
msgid ""
"Keeps a fast wheel from turning several pages at once. 0 ignores nothing."
msgstr ""
"Не дає швидкому коліщатку перегорнути кілька сторінок разом. 0 нічого не "
"ігнорує."

#: mcomix/preferences_dialog.py:280
msgid "Between books"
msgstr "Між книжками"

#: mcomix/preferences_dialog.py:283
msgid "Automatically open the next archive"
msgstr "Автоматично відкривати наступний архів"

#: mcomix/preferences_dialog.py:285
msgid ""
"Automatically open the next archive in the directory when flipping past the "
"last page, or the previous archive when flipping past the first page."
msgstr ""
"Автоматично відкривати наступний архів у каталозі після перегортування "
"останньої сторінки, або попередній архів після перегортування першої "
"сторінки."

#: mcomix/preferences_dialog.py:288
msgid "Automatically open next directory"
msgstr "Автоматично відкривати наступний каталог"

#: mcomix/preferences_dialog.py:290
msgid ""
"Automatically open the first file in the next sibling directory when "
"flipping past the last page of the last file in a directory, or the previous "
"directory when flipping past the first page of the first file."
msgstr ""
"Автоматично відкриває перший файл наступного сусіднього каталогу після "
"гортання за останню сторінку останнього файла в каталозі, або попередній "
"каталог після гортання за першу сторінку першого файла."

#: mcomix/preferences_dialog.py:293
msgid "Open first file when navigating to previous archive"
msgstr "Відкривати перший файл при переході до попереднього архіву"

#: mcomix/preferences_dialog.py:295
msgid ""
"Automatically open the first file of the previous archive when navigating to "
"it, instead of opening the last file of the previous archive."
msgstr ""
"При переході до попереднього архіву автоматично відкриває його перший файл, "
"а не останній."

#: mcomix/preferences_dialog.py:298
msgid "Open first file when navigating to previous directory"
msgstr "Відкривати перший файл при переході до попереднього каталогу"

#: mcomix/preferences_dialog.py:300
msgid ""
"Automatically open the first file of the previous directory when navigating "
"to it, instead of opening the last file of the previous directory."
msgstr ""
"При переході до попереднього каталогу автоматично відкриває його перший "
"файл, а не останній."

#: mcomix/preferences_dialog.py:302
msgid "File order"
msgstr "Порядок файлів"

#: mcomix/preferences_dialog.py:304
msgid "Sort files and directories by:"
msgstr "Впорядковувати файли й каталоги за:"

#: mcomix/preferences_dialog.py:307
msgid "Sort archives by:"
msgstr "Впорядковувати архіви за:"

#: mcomix/preferences_dialog.py:321
msgid "Use fullscreen by default"
msgstr "Типово вживати повноекранний режим"

#: mcomix/preferences_dialog.py:325
msgid "Automatically hide all toolbars in fullscreen"
msgstr "Автоматично ховати всі панелі в повноекранному режимі"

#: mcomix/preferences_dialog.py:331
msgid "Flip two pages in double page mode"
msgstr "Гортати по дві сторінки в двосторінковому режимі"

#: mcomix/preferences_dialog.py:333
msgid ""
"Flip two pages, instead of one, each time we flip pages in double page mode."
msgstr "Гортати дві сторінки замість однієї в двосторінковому режимі."

#: mcomix/preferences_dialog.py:335
msgid "Show only one page where appropriate:"
msgstr "Показувати лише одну сторінку там, де це доречно:"

#: mcomix/preferences_dialog.py:338
msgid "Page auto-resizing:"
msgstr "Автоматична зміна розміру сторінок:"

#: mcomix/preferences_dialog.py:341
msgid "Space between two pages (in pixels):"
msgstr "Відстань між двома сторінками (у пікселях):"

#: mcomix/preferences_dialog.py:346 mcomix/ui.py:535
msgid "Fit to size mode"
msgstr "Режим припасування до розміру"

#: mcomix/preferences_dialog.py:348
msgid "Fixed width for wide pages:"
msgstr "Стала ширина для широких сторінок:"

#: mcomix/preferences_dialog.py:353
msgid "Fixed height for wide pages:"
msgstr "Стала висота для широких сторінок:"

#: mcomix/preferences_dialog.py:358
msgid "Fixed width for other pages:"
msgstr "Стала ширина для решти сторінок:"

#: mcomix/preferences_dialog.py:363
msgid "Fixed height for other pages:"
msgstr "Стала висота для решти сторінок:"

#: mcomix/preferences_dialog.py:368
msgid "Slideshow"
msgstr "Слайдшоу"

#: mcomix/preferences_dialog.py:370
msgid "Slideshow delay (in seconds):"
msgstr "Затримка слайдшоу (у секундах):"

#: mcomix/preferences_dialog.py:375
msgid "Slideshow step (in pixels):"
msgstr "Крок слайдшоу (у пікселях):"

#: mcomix/preferences_dialog.py:379
msgid ""
"Specify the number of pixels to scroll while in slideshow mode. A positive "
"value will scroll forward, a negative value will scroll backwards, and a "
"value of 0 will cause the slideshow to always flip to a new page."
msgstr ""
"Задає кількість пікселів прокручування в режимі слайдшоу. Додатне значення "
"прокручує вперед, від’ємне — назад, а 0 змушує слайдшоу завжди переходити на "
"нову сторінку."

#: mcomix/preferences_dialog.py:382
msgid "During a slideshow automatically open the next archive"
msgstr "Під час слайдшоу автоматично відкривати наступний архів"

#: mcomix/preferences_dialog.py:384
msgid ""
"While in slideshow mode allow the next archive to automatically be opened."
msgstr "Дозволяє в режимі слайдшоу автоматично відкривати наступний архів."

#: mcomix/preferences_dialog.py:386
msgid "Rotation"
msgstr "Обертання"

#: mcomix/preferences_dialog.py:389
msgid "Automatically rotate images according to their metadata"
msgstr "Автоматично обертати зображення згідно з їхніми метаданими"

#: mcomix/preferences_dialog.py:391
msgid ""
"Automatically rotate images when an orientation is specified in the image "
"metadata, such as in an Exif tag."
msgstr ""
"Автоматично обертати зображення, якщо орієнтація вказана метаданих, "
"наприклад у Exif тазі."

#: mcomix/preferences_dialog.py:393
msgid "Image quality"
msgstr "Якість зображення"

#: mcomix/preferences_dialog.py:395
msgid "Scaling mode"
msgstr "Режим масштабування"

#: mcomix/preferences_dialog.py:407
msgid "Extraction and cache"
msgstr "Розпакування і кеш"

#: mcomix/preferences_dialog.py:415
msgid "Maximum number of concurrent extraction threads:"
msgstr "Найбільша кількість одночасних потоків розпакування:"

#: mcomix/preferences_dialog.py:419
msgid ""
"Set the maximum number of concurrent threads for formats that support it. A "
"value of 0 uses one thread for each processor."
msgstr ""
"Задає найбільшу кількість одночасних потоків для форматів, які це "
"підтримують. Значення 0 задає один потік на кожен процесор."

#: mcomix/preferences_dialog.py:421
msgid "Maximum number of concurrent thumbnail threads:"
msgstr "Найбільша кількість одночасних потоків для мініатюр:"

#: mcomix/preferences_dialog.py:425
msgid ""
"Set the maximum number of concurrent threads used to generate thumbnails. A "
"value of 0 uses one thread for each processor. Takes effect the next time "
"MComix is started."
msgstr ""
"Задає найбільшу кількість одночасних потоків для створення мініатюр. "
"Значення 0 задає один потік на кожен процесор. Набирає чинності при "
"наступному запуску MComix."

#: mcomix/preferences_dialog.py:428
msgid "Store thumbnails for opened files"
msgstr "Зберігати мініатюри відкритих файлів"

#: mcomix/preferences_dialog.py:430
msgid ""
"Store thumbnails for opened files according to the freedesktop.org "
"specification. These thumbnails are shared by many other applications, such "
"as most file managers."
msgstr ""
"Зберігати мініатюри для відкритих файлів, відповідно до специфікації "
"freedesktop.org. Ці мініатюри використовуються багатьма іншими додатками, "
"наприклад більшістю файлових менеджерів."

#: mcomix/preferences_dialog.py:432
msgid "Maximum number of pages to store in the cache:"
msgstr "Найбільша кількість сторінок, що зберігаються в кеші:"

#: mcomix/preferences_dialog.py:436
msgid ""
"Set the max number of pages to cache. A value of -1 will cache the entire "
"archive."
msgstr ""
"Задає найбільшу кількість сторінок у кеші. Значення -1 охопить весь архів."

#: mcomix/preferences_dialog.py:438
msgid "Magnifying Lens"
msgstr "Збільшуюче Скло"

#: mcomix/preferences_dialog.py:440
msgid "Magnifying lens size (in pixels):"
msgstr "Розмір лупи (у пікселях):"

#: mcomix/preferences_dialog.py:444
msgid ""
"Set the size of the magnifying lens. It is a square with a side of this many "
"pixels."
msgstr "Встановити розмір сторони квадратного збільшуючого скла."

#: mcomix/preferences_dialog.py:446
msgid "Magnification factor:"
msgstr "Коефіцієнт збільшення:"

#: mcomix/preferences_dialog.py:450
msgid "Set the magnification factor of the magnifying lens."
msgstr "Встановлює коефіцієнт збільшення для збільшуючого скла."

#: mcomix/preferences_dialog.py:454
msgid "Comment extensions:"
