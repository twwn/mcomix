msgstr "„%s“ vor dem Schließen neu schreiben?"

#: mcomix/file_actions.py:811
msgid ""
"The book has changes that the archive on disk does not hold. They are lost "
"when it closes."
msgstr ""
"Das Buch hat Änderungen, die das Archiv auf der Festplatte nicht enthält. "
"Beim Schließen gehen sie verloren."

#: mcomix/file_actions.py:813
msgid "_Close without saving"
msgstr "Schl_ießen ohne zu speichern"

#: mcomix/file_actions.py:867
#, python-format
msgid "Write \"%s\" again now?"
msgstr "„%s“ jetzt neu schreiben?"

