msgstr "שפה (עליך לאתחל את היישום):"

#: mcomix/preferences_dialog.py:137
msgid "Theme:"
msgstr "ערכת נושא:"

#: mcomix/preferences_dialog.py:140
msgid "Background"
msgstr "רקע"

#: mcomix/preferences_dialog.py:143
msgid "Use this colour as background:"
msgstr "השתמש בצבע זה כרקע:"

#: mcomix/preferences_dialog.py:144
msgid "Always use this selected colour as the background colour."
msgstr "השתמש תמיד בצבע הנבחר כצבע הרקע."

#: mcomix/preferences_dialog.py:145 mcomix/preferences_dialog.py:156
msgid "Use dynamic background colour"
msgstr "השתמש בצבע רקע משתנה (דינמי)"

# שמוצגת
#: mcomix/preferences_dialog.py:147
msgid "Automatically pick a background colour that fits the viewed image."
msgstr "קטוף אוטומטית צבע רקע שמתאים לתמונה שנצפית."

#: mcomix/preferences_dialog.py:154
msgid "Use this colour as the thumbnail background:"
msgstr "השתמש בצבע זה כרקע עבור תמונות־ציפורן:"

#: mcomix/preferences_dialog.py:155
msgid "Always use this selected colour as the thumbnail background colour."
msgstr "השתמש תמיד בצבע הנבחר כצבע רקע תמונות־ציפורן."

# למרקע
#: mcomix/preferences_dialog.py:158
msgid ""
"Automatically use the colour that fits the viewed image for the thumbnail "
"background."
msgstr "בחר אוטומטית צבע רקע שמתאים לרקע תמונות־ציפורן."

# on the side of, near
#: mcomix/preferences_dialog.py:163
msgid "Show page numbers on thumbnails"
msgstr "הצג מספרי עמודים לצד תמונות־ציפורן"

#: mcomix/preferences_dialog.py:166
msgid "Thumbnail size (in pixels):"
msgstr "מידת תמונות־ציפורן (בפיקסלים):"

#: mcomix/preferences_dialog.py:171
msgid "Transparency"
msgstr "שקיפות"

#: mcomix/preferences_dialog.py:174
msgid "Use checkered background for transparent images"
msgstr "השתמש ברקע משובץ עבור תמונות שקופות"

# Omitted: instead
#: mcomix/preferences_dialog.py:176
msgid ""
"Use a grey checkered background for transparent images. If this preference "
"is unset, the background is plain white instead."
msgstr ""
"השתמש ברקע אפור משובץ עבור תמונות שקופות. במידה והעדפה זו אינה מוגדרת, צבע "
"הרקע יהיה לבן."

#: mcomix/preferences_dialog.py:186
msgid "Files"
msgstr "קבצים"

#: mcomix/preferences_dialog.py:189
msgid "Automatically open the last viewed file on startup"
msgstr "פתח אוטומטית את הקובץ האחרון בעת הפעלה"

# באחרונה או בפעם האחרונה?
#: mcomix/preferences_dialog.py:191
msgid ""
"Automatically open, on startup, the file that was open when MComix was last "
"closed."
msgstr ""
"פתח אוטומטית, בזמן הפעלה, את הקובץ שהיה פתוח בזמן שהיישום MComix נסגר "
"באחרונה."

#: mcomix/preferences_dialog.py:194
msgid "Open the library on startup"
msgstr "פתיחת הספרייה עם ההפעלה"

#: mcomix/preferences_dialog.py:198
msgid "Open files in the window that is already open"
msgstr "פתיחת קבצים בחלון שכבר פתוח"

#: mcomix/preferences_dialog.py:200
msgid ""
"A book opened from a file manager or a command line goes to the MComix that "
"is running, instead of starting another. Takes effect when MComix is next "
"started."
msgstr ""
"חוברת שנפתחת ממנהל קבצים או משורת הפקודה עוברת אל MComix שכבר פועל, במקום "
"להפעיל עוד אחד. חל מההפעלה הבאה של MComix."

# זה לא ה-קבצים מאחר שמדובר כאן ברשימה של קבצים ולא בקבצים עצמם שנפתחו לאחרונה!
#: mcomix/preferences_dialog.py:202
msgid "Store information about recently opened files:"
msgstr "אחסן מידע אודות קבצים שנפתחו לאחרונה:"

#: mcomix/preferences_dialog.py:205
msgid "Save As opens at the last directory saved into"
msgstr "\"שמירה בשם\" נפתח במדור שאליו נשמר הקובץ האחרון"

#: mcomix/preferences_dialog.py:207
msgid ""
"Open the Save As dialog at the directory in which the last file was saved."
msgstr "פותח את דו־שיח \"שמירה בשם\" במדור שבו נשמר הקובץ האחרון."

#: mcomix/preferences_dialog.py:210
msgid "Save an edited archive in the format it was opened in"
msgstr "שמירת ארכיון שנערך בתבנית שבה נפתח"

#: mcomix/preferences_dialog.py:212
msgid ""
"Write an edited archive back as a ZIP, a tar, a 7z or a RAR, whichever it "
"was read as. The last two need the 7z and rar programs, which MComix does "
"not install; a format it cannot write is saved as a ZIP."
msgstr ""
"כתיבת ארכיון שנערך בחזרה כ־ZIP, tar, 7z או RAR, לפי התבנית שבה נקרא. שניים "
"אלה האחרונים דורשים את התוכניות 7z ו־rar, ש־MComix אינו מתקין; תבנית שאי "
"אפשר לכתוב נשמרת כ־ZIP."

#: mcomix/preferences_dialog.py:214
msgid "Prompts answered for good"
msgstr "שאלות שנענו אחת ולתמיד"

# גלילה חכמה עם המקש רווח
#: mcomix/preferences_dialog.py:233
msgid "Use smart scrolling"
msgstr "השתמש בגלילה חכמה"

#: mcomix/preferences_dialog.py:235
msgid ""
"With this preference set, the space key and mouse wheel do not only scroll "
"down or up, but also sideways and so try to follow the natural reading order "
"of the comic book."
msgstr ""
"בקביעת העדפה זו, המקש רווח וגלגל העכבר לא יגוללו רק מטה או מעלה, אלא גם "
"לצדדים ובכך MComix ינסה לעקוב אחר סדר הקריאה הטבעי של חוברת הקומיקס."

#: mcomix/preferences_dialog.py:240
msgid "Flip pages when scrolling off the edges of the page"
msgstr "דפדף עמודים בעת גלילה מחוץ לקצוות של העמוד"

# הדבר, העניין
# על מנת שהעמוד ידופדף
# Do not use this character ״
#: mcomix/preferences_dialog.py:242
msgid ""
"Flip pages when scrolling \"off the page\" with the scroll wheel or with the "
"arrow keys. It takes n consecutive \"steps\" with the scroll wheel or the "
"arrow keys for the pages to be flipped."
msgstr ""
"דפדוף עמודים בעת גלילה \"מחוץ לקצוות\" באמצעות גולל העכבר או באמצעות מקשי "
"החיצים. הדבר מצריך מספר \"צעדים\" עקביים עם גולל העכבר או מקשי החיצים על מנת "
"לדפדף בעמודים."

#: mcomix/preferences_dialog.py:245
msgid "Flip pages with a left click"
msgstr "דפדף עמודים בלחיצה שמאלית"

#: mcomix/preferences_dialog.py:247
msgid ""
"A left click on the page turns to the next one. Clicks with SHIFT or ALT "
"turn pages either way."
msgstr ""
"לחיצה שמאלית על העמוד עוברת לעמוד הבא. לחיצות עם SHIFT או ALT מדפדפות בכל "
"מקרה."

#: mcomix/preferences_dialog.py:249
msgid "Where a click lands:"
msgstr "היכן נוחתת הלחיצה:"

#: mcomix/preferences_dialog.py:253
msgid "Skip pages that cannot be shown"
msgstr "דילוג על עמודים שלא ניתן להציג"

#: mcomix/preferences_dialog.py:255
msgid ""
"Turn past a page whose image is damaged or cannot be read, instead of "
"showing the broken-image icon in its place."
msgstr ""
"דילוג על עמוד שהתמונה שלו פגומה או שלא ניתן לקרוא אותה, במקום להציג במקומו "
"את סמל התמונה הפגומה."

# בכל לחיצה
#: mcomix/preferences_dialog.py:257
msgid "Number of pixels to scroll per arrow key press:"
msgstr "מספר פיקסלים לגולל לכל לחיצה על מקש חץ:"

#: mcomix/preferences_dialog.py:261
msgid "Set the number of pixels to scroll on a page when using the arrow keys."
msgstr "קבע את מספר הפיקסלים לגולל בעמוד בעת שימוש במקשי החצים."

#: mcomix/preferences_dialog.py:263
msgid "Number of pixels to scroll per mouse wheel turn:"
msgstr "מספר פיקסלים לגולל לכל סיבוב של גלגל העכבר:"

#: mcomix/preferences_dialog.py:267
msgid "Set the number of pixels to scroll on a page when using a mouse wheel."
msgstr "קבע את מספר הפיקסלים לגולל בעמוד בעת שימוש בגלגל העכבר."

#: mcomix/preferences_dialog.py:269
msgid "Fraction of page to scroll per space key press (in percent):"
msgstr "מקטע עמוד לגולל לכל לחיצה על מקש הרווח (באחוזים):"

#: mcomix/preferences_dialog.py:274
msgid ""
"Sets the percentage by which the page will be scrolled down or up when the "
"space key is pressed."
msgstr "קביעת האחוז שבו העמוד יגולל מטה או מעלה כאשר מקש הרווח נלחץ."

#: mcomix/preferences_dialog.py:277
msgid "Number of \"steps\" to take before flipping the page:"
msgstr "מספר של \"צעדים\" שיש לקחת לפני דפדוף העמוד:"

# שדרושים/שנצרכים
#: mcomix/preferences_dialog.py:281
msgid ""
"Set the number of \"steps\" needed to flip to the next or previous page.  "
"Less steps will allow for very fast page turning but you might find yourself "
"accidentally turning pages."
msgstr ""
"קבע את המספר של \"צעדים\" שדרושים כדי לדפדף אל העמוד הבא או הקודם. פחות "
"צעדים יקנו דפדוף מהיר מאוד של עמודים אולם יש סיכוי שתמצא/י את עצמך מעלעל/ת "
"עמודים באופן מקרי ובלתי מכוון."

#: mcomix/preferences_dialog.py:284
msgid "Count the steps also when the page fits"
msgstr "לספור צעדים גם כשהעמוד נכנס בחלון"

#: mcomix/preferences_dialog.py:286
msgid ""
"A page that fits the window turns on the first step past it. With this, it "
"takes as many steps as above."
msgstr ""
"עמוד שנכנס בחלון מתדפדף בצעד הראשון מעבר לו. עם זה, נדרשים צעדים כמספר "
"שלמעלה."

#: mcomix/preferences_dialog.py:288
msgid "Milliseconds to ignore the wheel after it turns a page:"
msgstr "אלפיות שנייה שבהן גלגל העכבר מתעלם אחרי דפדוף:"

#: mcomix/preferences_dialog.py:292
msgid ""
"Keeps a fast wheel from turning several pages at once. 0 ignores nothing."
msgstr "מונע מגלגל מהיר לדפדף כמה עמודים בבת אחת. 0 לא מתעלם מכלום."

#: mcomix/preferences_dialog.py:294
msgid "Between books"
msgstr "בין חוברות"

#: mcomix/preferences_dialog.py:297
msgid "Automatically open the next archive"
msgstr "פתח את הארכיון הבא אוטומטית"

# past = מעבר = beyond
#: mcomix/preferences_dialog.py:299
msgid ""
"Automatically open the next archive in the directory when flipping past the "
"last page, or the previous archive when flipping past the first page."
msgstr ""
"פתח אוטומטית את הארכיון הבא שבמדור הקבצים בעת דפדוף מעבר לעמוד האחרון, או של "
"הארכיון הקודם בעת דפדוף מעבר לעמוד הראשון."

#: mcomix/preferences_dialog.py:302
msgid "Automatically open next directory"
msgstr "פתח את המדור הבא אוטומטית"

# past = מעבר = beyond
#: mcomix/preferences_dialog.py:304
msgid ""
"Automatically open the first file in the next sibling directory when "
"flipping past the last page of the last file in a directory, or the previous "
"directory when flipping past the first page of the first file."
msgstr ""
"פתח אוטומטית את הקובץ הבא שבמדור הקבצים המקביל הבא בעת דפדוף מעבר לעמוד "
"האחרון, או של הקובץ האחרון שבמדור, או המדור הקודם בעת דפדוף מעבר לעמוד "
"הראשון של הקובץ הראשון."

#: mcomix/preferences_dialog.py:307
msgid "Open first file when navigating to previous archive"
msgstr "פתיחת הקובץ הראשון בעת מעבר לארכיון הקודם"

#: mcomix/preferences_dialog.py:309
msgid ""
"Automatically open the first file of the previous archive when navigating to "
"it, instead of opening the last file of the previous archive."
msgstr ""
"בעת מעבר לארכיון הקודם ייפתח אוטומטית הקובץ הראשון שבו, במקום הקובץ האחרון."

#: mcomix/preferences_dialog.py:312
msgid "Open first file when navigating to previous directory"
msgstr "פתיחת הקובץ הראשון בעת מעבר למדור הקודם"

#: mcomix/preferences_dialog.py:314
msgid ""
"Automatically open the first file of the previous directory when navigating "
"to it, instead of opening the last file of the previous directory."
msgstr ""
"בעת מעבר למדור הקודם ייפתח אוטומטית הקובץ הראשון שבו, במקום הקובץ האחרון."

#: mcomix/preferences_dialog.py:317
msgid "Open a folder with the folders in it as one book"
msgstr "פתיחת תיקייה עם התיקיות שבתוכה כספר אחד"

#: mcomix/preferences_dialog.py:319
msgid ""
"The files of the folders in a folder, two levels down, follow its own. The "
"next directory is then the one beside it."
msgstr ""
"הקבצים של התיקיות שבתוך תיקייה, עד שתי רמות מטה, באים אחרי הקבצים שלה. המדור "
"הבא הוא אז זה שלצידה."

#: mcomix/preferences_dialog.py:321
msgid "File order"
msgstr "מסדר קבצים"

#: mcomix/preferences_dialog.py:323
msgid "Sort files and directories by:"
msgstr "סדר קבצים ומדורים לפי:"

#: mcomix/preferences_dialog.py:326
msgid "Sort archives by:"
msgstr "סדר ארכיונים לפי:"

# שימוש במסך
#: mcomix/preferences_dialog.py:340
msgid "Use fullscreen by default"
msgstr "השתמש במסך מלא באופן משתמט"

#: mcomix/preferences_dialog.py:344
msgid "Automatically hide all toolbars in fullscreen"
msgstr "הסתר אוטומטית את כל סרגלי הכלים במסך מלא"

#: mcomix/preferences_dialog.py:347
msgid "Page number in fullscreen:"
msgstr "מספר העמוד במסך מלא:"

#: mcomix/preferences_dialog.py:353
msgid "Flip two pages in double page mode"
msgstr "דפדף שני עמודים במצב של עמוד כפול"

#: mcomix/preferences_dialog.py:355
msgid ""
"Flip two pages, instead of one, each time we flip pages in double page mode."
msgstr ""
"דפדף שני עמודים, במקום אחד, בכל פעם שאנחנו מדפדפים עמודים במצב של עמוד כפול."

#: mcomix/preferences_dialog.py:357
msgid "Show only one page where appropriate:"
msgstr "הצג עמוד אחד בלבד במקום שהדבר הולם:"

#: mcomix/preferences_dialog.py:360
msgid "Page auto-resizing:"
msgstr "שינוי גודל אוטומטי של עמודים:"

#: mcomix/preferences_dialog.py:363
msgid "Space between two pages (in pixels):"
msgstr "רווח בין שני עמודים (בפיקסלים):"

#: mcomix/preferences_dialog.py:368 mcomix/ui.py:560
msgid "Fit to size mode"
msgstr "מצב התאמה לגודל"

#: mcomix/preferences_dialog.py:370
msgid "Fixed width for wide pages:"
msgstr "רוחב קבוע לעמודים רחבים:"

#: mcomix/preferences_dialog.py:375
msgid "Fixed height for wide pages:"
msgstr "גובה קבוע לעמודים רחבים:"

#: mcomix/preferences_dialog.py:380
msgid "Fixed width for other pages:"
msgstr "רוחב קבוע לשאר העמודים:"

#: mcomix/preferences_dialog.py:385
msgid "Fixed height for other pages:"
msgstr "גובה קבוע לשאר העמודים:"

#: mcomix/preferences_dialog.py:390
msgid "Slideshow"
msgstr "מצגת"

#: mcomix/preferences_dialog.py:392
msgid "Slideshow delay (in seconds):"
msgstr "שיהוי מצגת (בשניות):"

# מדרג
#: mcomix/preferences_dialog.py:397
msgid "Slideshow step (in pixels):"
msgstr "צעדי מצגת (בשניות):"

#: mcomix/preferences_dialog.py:401
msgid ""
"Specify the number of pixels to scroll while in slideshow mode. A positive "
"value will scroll forward, a negative value will scroll backwards, and a "
"value of 0 will cause the slideshow to always flip to a new page."
msgstr ""
"ציין את מספר הפיקסלים לגולל במהלך מצב מצגת. ערך חיובי יגולל הלאה, ערך שלילי "
"יגולל לאחור, וערך של 0 יגרום למצגת לדפדף תמיד אל עמוד חדש."

#: mcomix/preferences_dialog.py:404
msgid "During a slideshow automatically open the next archive"
msgstr "במהלך מצגת פתח אוטומטית את הארכיון הבא."

#: mcomix/preferences_dialog.py:406
msgid ""
"While in slideshow mode allow the next archive to automatically be opened."
msgstr "בהיותי במצב מצגת פתח אוטומטית את הארכיון הבא."

# סיבוב
#: mcomix/preferences_dialog.py:408
msgid "Rotation"
msgstr "רוטציה"

#: mcomix/preferences_dialog.py:411
msgid "Automatically rotate images according to their metadata"
msgstr "סובב אוטומטי של תמונות בהתאם לנתונים המוצמדים (Metadata) הטמונים בתוכן"

#: mcomix/preferences_dialog.py:413
msgid ""
"Automatically rotate images when an orientation is specified in the image "
"metadata, such as in an Exif tag."
msgstr ""
"סובב אוטומטי של תמונות במידה ומצוין כיוון בנתונים המוצמדים (Metadata) של "
"התמונה, כמו למשל בתווית Exif."

#: mcomix/preferences_dialog.py:415
msgid "Image quality"
msgstr "איכות תמונה"

# מדרגיות
#: mcomix/preferences_dialog.py:417
msgid "Scaling mode"
msgstr "מצב סילומיות"

#: mcomix/preferences_dialog.py:420
msgid "Screen colour profile:"
msgstr "פרופיל צבע של המסך:"

#: mcomix/preferences_dialog.py:423
msgid "Rendering intent:"
msgstr "כוונת עיבוד:"

#: mcomix/preferences_dialog.py:435
msgid "Extraction and cache"
msgstr "חילוץ ומטמון"

#: mcomix/preferences_dialog.py:443
msgid "Maximum number of concurrent extraction threads:"
msgstr "מספר מרבי של תהליכוני חילוץ במקביל:"

#: mcomix/preferences_dialog.py:447
msgid ""
"Set the maximum number of concurrent threads for formats that support it. A "
"value of 0 uses one thread for each processor. For PDFs, 0 also keeps within "
"a sixteenth of the memory."
msgstr ""
"קובע את המספר המרבי של תהליכונים במקביל עבור תבניות התומכות בכך. הערך 0 "
"משתמש בתהליכון אחד לכל מעבד. עבור קובצי PDF, הערך 0 גם אינו חורג מ־1/16 "
"מהזיכרון."

#: mcomix/preferences_dialog.py:449
msgid "Maximum number of concurrent thumbnail threads:"
msgstr "מספר מרבי של תהליכונים במקביל לתמונות־ציפורן:"

#: mcomix/preferences_dialog.py:453
msgid ""
"Set the maximum number of concurrent threads used to generate thumbnails. A "
"value of 0 uses one thread for each processor. Takes effect the next time "
"MComix is started."
msgstr ""
"קובע את המספר המרבי של תהליכונים במקביל ליצירת תמונות־ציפורן. הערך 0 משתמש "
"בתהליכון אחד לכל מעבד. ייכנס לתוקף בהפעלה הבאה של MComix."

#: mcomix/preferences_dialog.py:455
msgid "Unpack books in:"
msgstr "חילוץ חוברות אל:"

#: mcomix/preferences_dialog.py:459
msgid "Store thumbnails for opened files"
msgstr "אחסן תמונות־ציפורן עבור קבצים פתוחים"

#: mcomix/preferences_dialog.py:461
msgid ""
"Store thumbnails for opened files according to the freedesktop.org "
"specification. These thumbnails are shared by many other applications, such "
"as most file managers."
msgstr ""
"אחסן תמונות־ציפורן עבור קבצים פתוחים בהתאם למפרט של freedesktop.org. תמונות־"
"ציפורן אלה משותפות על ידי יישומים רבים אחרים, כגון רוב מנהלי הקבצים."

#: mcomix/preferences_dialog.py:463
msgid "Maximum number of pages to store in the cache:"
msgstr "מספר עמודים מרבי לאחסון בתוך המטמון:"

# לחלוטין
#: mcomix/preferences_dialog.py:467
msgid ""
"Set the max number of pages to cache. A value of -1 will cache the entire "
"archive."
msgstr "קבע את מספר העמודים המרבי להטמנה. ערך של 1- יטמין את הארכיון בשלמותו."

#: mcomix/preferences_dialog.py:469
msgid "Magnifying Lens"
msgstr "עדשת מגדלת"

#: mcomix/preferences_dialog.py:471
msgid "Magnifying lens size (in pixels):"
msgstr "גודל עדשת המגדלת (בפיקסלים):"

# עם פיקסלים רבים בצדדיה
#: mcomix/preferences_dialog.py:475
msgid ""
"Set the size of the magnifying lens. It is a square with a side of this many "
"pixels."
msgstr ""
"קבע את גודל עדשת המגדלת. כעדשת המגדלת היא ריבוע עם מספר פיקסלים זה בצידיה."

# יחס ההגדלה
#: mcomix/preferences_dialog.py:477
msgid "Magnification factor:"
msgstr "מידת ההגדלה:"

#: mcomix/preferences_dialog.py:481
msgid "Set the magnification factor of the magnifying lens."
msgstr "קבע את מידת ההגדלה של עדשת המגדלת."

#: mcomix/preferences_dialog.py:485
msgid "Comment extensions:"
msgstr "סיומות הערה:"

#: mcomix/preferences_dialog.py:488
msgid "Animated images"
msgstr "תמונות מונפשות"

#: mcomix/preferences_dialog.py:490
msgid "Animation mode:"
msgstr "מצב הנפשה:"

#: mcomix/preferences_dialog.py:511
msgid "_Reset keys"
msgstr "אי_פוס מקשים"

#: mcomix/preferences_dialog.py:513
msgid "Resets all keyboard shortcuts to their default values."
msgstr "מאפס את כל קיצורי המקלדת לערכי ברירת המחדל שלהם."

#: mcomix/preferences_dialog.py:516
msgid "Clear _dialog choices"
msgstr "ניקוי בחירות _דו־שיח"

#: mcomix/preferences_dialog.py:518
msgid ""
"Clears all dialog choices that you have previously chosen not to be asked "
"again."
msgstr "איפוס כל ברירות דו שיח שבעבר בחרת שלא להישאל עליהם בשנית."

#: mcomix/preferences_dialog.py:553
msgid "Ask every time"
msgstr "לשאול בכל פעם"

#: mcomix/preferences_dialog.py:558
msgid ""
"What MComix answers this prompt with instead of asking. This is what the "
"prompt's \"Do not ask again\" box sets."
msgstr ""
"מה ש־MComix עונה על שאלה זו במקום לשאול אותה. זה מה שתיבת הסימון \"אל תשאל "
"אותי שנית.\" שבשאלה קובעת."

#: mcomix/preferences_dialog.py:580
msgid "Auto-detect (Default)"
msgstr "איתור אוטומטי (משתמט)"

#: mcomix/preferences_dialog.py:622
msgid "Follow the system"
msgstr "בהתאם למערכת"

#: mcomix/preferences_dialog.py:623
msgid "Light"
msgstr "בהיר"

#: mcomix/preferences_dialog.py:624
msgid "Dark"
msgstr "כהה"

#: mcomix/preferences_dialog.py:625
msgid "Pitch black"
msgstr "שחור מוחלט"

#: mcomix/preferences_dialog.py:631
msgid ""
"How MComix itself is painted, whatever the desktop asks for. Pitch black is "
"the dark theme with black backgrounds, which a screen that lights its pixels "
"one by one shows as no light at all."
msgstr ""
"כיצד MComix עצמו נצבע, יהיו הגדרות שולחן העבודה אשר יהיו. שחור מוחלט הוא "
"ערכת הנושא הכהה עם רקעים שחורים, שמסך המדליק את הפיקסלים שלו אחד אחד מציג "
"כהיעדר אור מוחלט."

#: mcomix/preferences_dialog.py:668
msgid "Restart MComix in the language you picked?"
msgstr "להפעיל מחדש את MComix בשפה שבחרת?"

#: mcomix/preferences_dialog.py:669
msgid ""
"MComix is translated as it starts, so most of the interface stays in the "
"language it started in until it is started again. The book being read, its "
"page and the window size are kept."
msgstr ""
"‏MComix מתורגם בעת ההפעלה, ולכן רוב הממשק יישאר בשפה שבה הוא הופעל עד להפעלה "
"מחדש. הספר הנקרא, העמוד שבו וגודל החלון יישמרו."

#: mcomix/preferences_dialog.py:683 mcomix/preferences_dialog.py:832
#: mcomix/preferences_dialog.py:914 mcomix/preferences_dialog.py:977
#: mcomix/ui.py:566
msgid "Never"
msgstr "לעולם לא"

#: mcomix/preferences_dialog.py:684
msgid "Only for title pages"
msgstr "עבור כותרות עמודים בלבד"

#: mcomix/preferences_dialog.py:685
msgid "Only for wide images"
msgstr "עבור תמונות רחבות בלבד"

#: mcomix/preferences_dialog.py:686 mcomix/preferences_dialog.py:833
#: mcomix/preferences_dialog.py:915
msgid "Always"
msgstr "תמיד"

#: mcomix/preferences_dialog.py:693
msgid ""
"When showing the first page of an archive, or an image's width exceeds its "
"height, only a single page will be displayed."
msgstr ""
"בעת הצגת העמוד הראשון של ארכיון, או כשרוחב התמונה עולה על גובהה, רק עמוד "
"בודד יוצג."

#: mcomix/preferences_dialog.py:711
msgid "Prefer same scale"
msgstr "העדפת אותו קנה מידה"

#: mcomix/preferences_dialog.py:712
msgid "Prefer same size"
msgstr "העדפת אותו גודל"

#: mcomix/preferences_dialog.py:713
msgid "Fit to same size"
msgstr "התאמה לאותו גודל"

#: mcomix/preferences_dialog.py:720
msgid "Maintain relative size or fit to same size."
msgstr "שומר על הגודל היחסי או מתאים לאותו גודל."

#: mcomix/preferences_dialog.py:734 mcomix/preferences_dialog.py:781
msgid "No sorting"
msgstr "ללא מיון"

#: mcomix/preferences_dialog.py:735
msgid "File name"
msgstr "שם קובץ"

#: mcomix/preferences_dialog.py:736
msgid "File name (GLib)"
msgstr "שם קובץ (GLib)"

#: mcomix/preferences_dialog.py:737 mcomix/library/book_area.py:256
msgid "File size"
msgstr "גודל קובץ"

#: mcomix/preferences_dialog.py:738
msgid "Last modified"
msgstr "שונה לאחרונה"

#: mcomix/preferences_dialog.py:744 mcomix/preferences_dialog.py:790
#: mcomix/library/book_area.py:260
msgid "Ascending"
msgstr "סדר מיון עולה"

#: mcomix/preferences_dialog.py:745 mcomix/preferences_dialog.py:791
#: mcomix/library/book_area.py:261
msgid "Descending"
msgstr "סדר מיון יורד"

#: mcomix/preferences_dialog.py:753
msgid ""
"Files will be opened and displayed according to the sort order specified "
"here. This option does not affect ordering within archives."
msgstr ""
"קבצים יפתחו ויוצגו בהתאם אל סדר המיון שמצוין כאן. אפשרות זו לא משפיעה על "
"הסדר שכבר מצוי בתוך ארכיונים."

#: mcomix/preferences_dialog.py:782
msgid "Natural order"
msgstr "סדר טבעי"

#: mcomix/preferences_dialog.py:783
msgid "Literal order"
msgstr "סדר מילולי"

#: mcomix/preferences_dialog.py:784
msgid "GLib order"
msgstr "סדר GLib"

#: mcomix/preferences_dialog.py:799
msgid ""
"Files within archives will be sorted according to the order specified here. "
"Natural order will sort numbered files based on their natural order, i.e. 1, "
"2, ..., 10, while literal order uses standard C sorting, i.e. 1, 2, 34, 5. "
"GLib order will sort files using collate keys generated by GLib/GTK, used by "
"many other GTK applications."
msgstr ""
"קבצים שבתוך ארכיונים ימוינו לפי הסדר שנקבע כאן. סדר טבעי ימיין קבצים "
"ממוספרים לפי סדרם הטבעי, כלומר 1, 2, ..., 10, ואילו סדר מילולי משתמש במיון "
"התקני של C, כלומר 1, 2, 34, 5. סדר GLib ימיין קבצים לפי מפתחות השוואה ש־GLib/"
"GTK מייצרים, ובהם משתמשים יישומי GTK רבים אחרים."

# הרשימת המשותפת של הקבצים שנפתחו לאחרונה
#: mcomix/preferences_dialog.py:838
msgid ""
"Add information about all files opened from within MComix to the shared "
"recent files list."
msgstr ""
"הוסף מידע אודות כל הקבצים שנפתחו מתוך MComix אל רשימת הקבצים האחרונים "
"המשותפת."

#: mcomix/preferences_dialog.py:858
msgid "Delete information about recently opened files?"
msgstr "למחוק מידע אודות קבצים שנפתחו לאחרונה?"

# באשר לעמודים שנקראו
#: mcomix/preferences_dialog.py:859
msgid ""
"This will remove all entries from the \"Recent\" menu, and clear information "
"about last read pages."
msgstr ""
"אפשרות זו תסיר את כל הרשומות שבתפריט \"קבצים אחרונים\", ותאפס מידע אודות "
"עמודים שנקראו לאחרונה."

#: mcomix/preferences_dialog.py:872
msgid "Normal (fast)"
msgstr "רגיל (מהיר)"

#: mcomix/preferences_dialog.py:873
msgid "Bilinear"
msgstr "דו־קווי"

#: mcomix/preferences_dialog.py:874
msgid "Hyperbolic (slow)"
msgstr "היפרבולי (איטי)"

# איכות שינוי גודל באיכות גבוהה
#: mcomix/preferences_dialog.py:880
msgid ""
"Changes how images are scaled. Slower algorithms result in higher quality "
"resizing, but longer page loading times."
msgstr ""
"משנה את אופן התאמת הממדים של התמונות. אלגוריתמים איטיים יניבו איכות שינוי "
"גודל גבוהה, אולם זמני טעינת עמודים יהיו ארוכים יותר."

#: mcomix/preferences_dialog.py:897
msgid "Anywhere: the next page"
msgstr "בכל מקום: העמוד הבא"

#: mcomix/preferences_dialog.py:898
msgid "Halves: back and forward"
msgstr "חצאים: אחורה וקדימה"

#: mcomix/preferences_dialog.py:899
msgid "Thirds: back, fullscreen, forward"
msgstr "שלישים: אחורה, מסך מלא, קדימה"

#: mcomix/preferences_dialog.py:907
msgid ""
"With \"Flip pages with a left click\": the left half or third of the page "
"turns back and the right one forward; the middle third enters or leaves "
"fullscreen. In manga mode left and right change places."
msgstr ""
"עם „הפיכת עמודים בלחיצה שמאלית”: החצי או השליש השמאלי של העמוד חוזר אחורה "
"והימני מתקדם; השליש האמצעי נכנס למסך מלא או יוצא ממנו. במצב מנגה שמאל וימין "
"מתחלפים."

#: mcomix/preferences_dialog.py:916
msgid "For a few seconds after a page turn"
msgstr "לכמה שניות לאחר מעבר עמוד"

#: mcomix/preferences_dialog.py:921
msgid "The pages on screen and the number of pages, in the lower right corner."
msgstr "העמודים שעל המסך ומספר העמודים, בפינה הימנית התחתונה."

#: mcomix/preferences_dialog.py:937
msgid "None"
msgstr "אין"

#: mcomix/preferences_dialog.py:939
msgid ""
"The ICC profile of the screen, such as one made by calibrating it. Pages are "
"converted into it from sRGB. Leave it empty where the desktop already "
"converts for the screen."
msgstr ""
"פרופיל ה־ICC של המסך, כגון זה שנוצר בכיול שלו. העמודים מומרים אליו מ־sRGB. "
"יש להשאיר ריק כאשר שולחן העבודה כבר ממיר עבור המסך."

#: mcomix/preferences_dialog.py:957
msgid "Perceptual"
msgstr "תפיסתי"

#: mcomix/preferences_dialog.py:958
msgid "Relative colorimetric"
msgstr "טבלת צבע יחסית"

#: mcomix/preferences_dialog.py:959
msgid "Saturation"
msgstr "רוויה"

#: mcomix/preferences_dialog.py:960
msgid "Absolute colorimetric"
msgstr "טבלת צבע מוחלטת"

#: mcomix/preferences_dialog.py:971
msgid ""
"How colours the screen cannot show are brought within its range, when a "
"screen colour profile is set. Perceptual keeps the colours in proportion; "
"relative colorimetric keeps those the screen can show exact."
msgstr ""
