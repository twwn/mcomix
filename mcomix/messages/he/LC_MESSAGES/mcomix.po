msgid "Rename collection?"
msgstr "לשנות שם אוסף?"

#: mcomix/library/collection_area.py:351
msgid "Please enter a new name for the selected collection."
msgstr "נא להזין שם חדש עבור האוסף הנוכחי."

#: mcomix/library/collection_area.py:378
#, python-format
msgid "Could not change the name to '%s'."
msgstr "לא ניתן לשנות את השם אל '%s'."

#: mcomix/library/collection_area.py:394
msgid "Could not duplicate collection."
msgstr "לא ניתן לשכפל אוסף."

# מקור
#: mcomix/library/collection_area.py:584
msgid "Root"
msgstr "שורש"

#: mcomix/library/collection_area.py:587
#, python-format
msgid ""
"Put the collection '%(subcollection)s' in the collection "
"'%(supercollection)s'."
msgstr "השמת האוסף '%(subcollection)s' בתוך האוסף '%(supercollection)s'."

#: mcomix/library/collection_area.py:603
#, python-format
msgid "Add books to '%s'."
msgstr "הוסף חוברות אל '%s'."

# אולי מוטב יהיה להחליף את המילה from "מן" אל "מהאוסף" ואת המילה to "אל" אל "אל האוסף"
#: mcomix/library/collection_area.py:606
#, python-format
msgid ""
"Move books from '%(source collection)s' to '%(destination collection)s'."
msgstr ""
"העברת חוברות מהאוסף '%(source collection)s' אל האוסף "
"'%(destination collection)s'."

#: mcomix/library/control_area.py:77
msgid "_Search:"
msgstr "_חיפוש:"

# התאמת אותיות גדולות/קטנות
#: mcomix/library/control_area.py:83
msgid ""
"Display only those books that have the specified text string in their full "
"path. The search is not case sensitive."
msgstr ""
"הצגה של חוברות שלהן מחרוזת התמליל שמצוינת בנתיב המלא שלהן, בלבד. החיפוש אינו "
"תלוי רישיות."

