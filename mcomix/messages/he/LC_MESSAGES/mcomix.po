#: mcomix/about_dialog.py:37
#, python-format
msgid "%s is an image viewer specifically designed to handle comic books."
msgstr "‏%s הינו מציג תמונות שתוכנן במיוחד לטיפול ולניהול של חוברות קומיקס."

#: mcomix/about_dialog.py:39
msgid ""
"It reads ZIP, RAR, 7z, tar and LHA archives, PDF, DjVu and AZW3 files, as "
"well as plain image files."
msgstr ""
"ביכולתו לקרוא ארכיוני ZIP, RAR, 7z, tar ו־LHA, קבצי PDF, DjVu ו־AZW3, וכמו "
"כן גם קבצי תמונה רגילים."

#: mcomix/about_dialog.py:43
#, python-format
msgid "%s is licensed under the terms of the GNU General Public License."
msgstr "‏%s רשוי תחת הרישיון הציבורי הכללי של GNU."

#: mcomix/about_dialog.py:45
#, python-format
msgid "A copy of this license can be obtained from %s"
msgstr "ניתן להשיג עותק של רישיון זה בכתובת %s"

