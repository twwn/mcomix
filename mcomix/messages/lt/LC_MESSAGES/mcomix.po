msgstr "Pakeis_ti"

#: mcomix/run.py:56
msgid "[OPTION...] [PATH]"
msgstr "[PARINKTIS...] [KELIAS]"

#: mcomix/run.py:57
msgid "View images and comic book archives."
msgstr "Paveikslėlių ir komiksų archyvų peržiūra."

#: mcomix/run.py:60
msgid "Show this help and exit."
msgstr "Parodyti šią pagalbą ir išeiti."

#: mcomix/run.py:62
msgid "Start the application in slideshow mode."
msgstr "Paleisti programą skaidrių rodymo veiksenoje."

#: mcomix/run.py:64
msgid "Show the library on startup."
msgstr "Paleidžiant parodyti biblioteką."

#: mcomix/run.py:67
msgid "Show the version number and exit."
msgstr "Parodyti versijos numerį ir išeiti."

#: mcomix/run.py:69
msgid "Temporarily override the interface language."
msgstr "Laikinai pakeičia sąsajos kalbą."

#: mcomix/run.py:71
msgid "Open the file at the given page."
msgstr "Atveria failą nurodytame puslapyje."

#: mcomix/run.py:79
msgid ""
"Open a window of its own, whatever the preferences say about the window that "
"is already open."
msgstr ""
"Atverti atskirą langą, kad ir ką nustatymai sakytų apie jau atvertą langą."

#: mcomix/run.py:81
msgid "View modes"
msgstr "Rodymo veiksenos"

#: mcomix/run.py:83
msgid "Start the application in fullscreen mode."
msgstr "Paleisti programą viso ekrano veiksenoje."

#: mcomix/run.py:85
msgid "Start the application in manga mode."
msgstr "Paleisti programą mangos veiksenoje."

#: mcomix/run.py:87
msgid "Start the application in double page mode."
msgstr "Paleisti programą dviejų puslapių veiksenoje."

#: mcomix/run.py:89
msgid "Zoom modes"
msgstr "Mastelio veiksenos"

#: mcomix/run.py:92
msgid "Start the application with zoom set to best fit mode."
msgstr "Paleisti programą geriausio talpinimo veiksenoje."

#: mcomix/run.py:95
msgid "Start the application with zoom set to fit width."
msgstr "Paleisti programą talpinimo pagal plotį veiksenoje."

#: mcomix/run.py:98
msgid "Start the application with zoom set to fit height."
msgstr "Paleisti programą talpinimo pagal aukštį veiksenoje."

#: mcomix/run.py:100
msgid "Debug options"
msgstr "Derinimo parinktys"

#: mcomix/run.py:104
msgid "Sets the desired output log level."
msgstr "Nustato pageidaujamą žurnalo lygį."

#: mcomix/run.py:107
msgid "Writes the log to FILE as well."
msgstr "Žurnalą rašo ir į FILE."

#: mcomix/run.py:142
