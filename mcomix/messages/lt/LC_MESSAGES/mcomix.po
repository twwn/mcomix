#: mcomix/preferences_dialog.py:136
msgid "Theme:"
msgstr "Tema:"

#: mcomix/preferences_dialog.py:139
msgid "Background"
msgstr "Fonas"

#: mcomix/preferences_dialog.py:142
msgid "Use this colour as background:"
msgstr "Naudoti šią spalvą kaip foną:"

#: mcomix/preferences_dialog.py:143
msgid "Always use this selected colour as the background colour."
msgstr "Visada naudoti pasirinktą spalvą kaip fono spalvą."

#: mcomix/preferences_dialog.py:144 mcomix/preferences_dialog.py:155
msgid "Use dynamic background colour"
msgstr "Fonui naudoti kintančią spalvą"

#: mcomix/preferences_dialog.py:146
msgid "Automatically pick a background colour that fits the viewed image."
msgstr "Automatiškai parinkti fono spalvą, tinkančią rodomam paveikslėliui."

#: mcomix/preferences_dialog.py:153
msgid "Use this colour as the thumbnail background:"
msgstr "Naudoti šią spalvą kaip miniatiūrų foną:"

#: mcomix/preferences_dialog.py:154
msgid "Always use this selected colour as the thumbnail background colour."
msgstr "Visada naudoti pasirinktą spalvą kaip miniatiūrų fono spalvą."

#: mcomix/preferences_dialog.py:157
msgid ""
"Automatically use the colour that fits the viewed image for the thumbnail "
"background."
msgstr ""
"Miniatiūrų fonui automatiškai naudoti spalvą, tinkančią rodomam "
"paveikslėliui."

#: mcomix/preferences_dialog.py:162
msgid "Show page numbers on thumbnails"
msgstr "Rodyti puslapių numerius miniatiūrose"

#: mcomix/preferences_dialog.py:165
msgid "Thumbnail size (in pixels):"
msgstr "Miniatiūrų dydis (pikseliais):"

#: mcomix/preferences_dialog.py:170
msgid "Transparency"
msgstr "Permatomumas"

#: mcomix/preferences_dialog.py:173
msgid "Use checkered background for transparent images"
msgstr "Skaidriems paveikslėliams naudoti languotą foną"

#: mcomix/preferences_dialog.py:175
msgid ""
"Use a grey checkered background for transparent images. If this preference "
"is unset, the background is plain white instead."
msgstr ""
"Skaidriems paveikslėliams naudoti pilką languotą foną. Jei ši nuostata "
"išjungta, fonas yra vientisai baltas."

#: mcomix/preferences_dialog.py:185
msgid "Files"
msgstr "Failai"

#: mcomix/preferences_dialog.py:188
msgid "Automatically open the last viewed file on startup"
msgstr "Paleidžiant automatiškai atverti paskutinį žiūrėtą failą"

#: mcomix/preferences_dialog.py:190
msgid ""
"Automatically open, on startup, the file that was open when MComix was last "
"closed."
msgstr ""
"Paleidžiant automatiškai atveria failą, kuris buvo atvertas paskutinį kartą "
"užveriant MComix."

#: mcomix/preferences_dialog.py:193
msgid "Open the library on startup"
msgstr "Paleidžiant atverti biblioteką"

#: mcomix/preferences_dialog.py:196
msgid "Store information about recently opened files:"
msgstr "Saugoti informaciją apie neseniai atvertus failus:"

#: mcomix/preferences_dialog.py:199
msgid "Save As opens at the last directory saved into"
msgstr "„Išsaugoti kaip“ atveriama paskutiniame naudotame aplanke"

#: mcomix/preferences_dialog.py:201
msgid ""
"Open the Save As dialog at the directory in which the last file was saved."
msgstr ""
"Atveria „Išsaugoti kaip“ langą aplanke, kuriame išsaugotas paskutinis failas."

#: mcomix/preferences_dialog.py:204
msgid "Save an edited archive in the format it was opened in"
msgstr "Įrašyti taisytą archyvą tokiu formatu, kokiu jis buvo atvertas"

#: mcomix/preferences_dialog.py:206
msgid ""
"Write an edited archive back as a ZIP, a tar, a 7z or a RAR, whichever it "
"was read as. The last two need the 7z and rar programs, which MComix does "
"not install; a format it cannot write is saved as a ZIP."
msgstr ""
"Įrašyti taisytą archyvą atgal kaip ZIP, tar, 7z ar RAR – priklausomai nuo "
"to, kaip jis buvo perskaitytas. Paskutiniams dviem reikia 7z ir rar "
"programų, kurių MComix neįdiegia; formatas, kurio įrašyti negalima, įrašomas "
"kaip ZIP."

#: mcomix/preferences_dialog.py:208
msgid "Prompts answered for good"
msgstr "Kartą visiems laikams atsakyti klausimai"

#: mcomix/preferences_dialog.py:227
msgid "Use smart scrolling"
msgstr "Naudoti išmanų slinkimą"

#: mcomix/preferences_dialog.py:229
msgid ""
"With this preference set, the space key and mouse wheel do not only scroll "
"down or up, but also sideways and so try to follow the natural reading order "
"of the comic book."
msgstr ""
"Kai ši nuostata įjungta, tarpo klavišas ir pelės ratukas slenka ne tik žemyn "
"ar aukštyn, bet ir į šonus, taip stengiantis sekti natūralia komikso "
"skaitymo tvarka."

#: mcomix/preferences_dialog.py:234
msgid "Flip pages when scrolling off the edges of the page"
msgstr "Versti puslapius slenkant už puslapio kraštų"

#: mcomix/preferences_dialog.py:236
msgid ""
"Flip pages when scrolling \"off the page\" with the scroll wheel or with the "
"arrow keys. It takes n consecutive \"steps\" with the scroll wheel or the "
"arrow keys for the pages to be flipped."
msgstr ""
"Verčia puslapius slenkant „už puslapio“ pelės ratuku arba rodyklių "
"klavišais. Puslapiui apversti reikia n iš eilės einančių „žingsnių“ ratuku "
"arba rodyklėmis."

#: mcomix/preferences_dialog.py:239
msgid "Flip pages with a left click"
msgstr "Versti puslapius kairiuoju spustelėjimu"

#: mcomix/preferences_dialog.py:241
msgid ""
"A left click on the page turns to the next one. Clicks with SHIFT or ALT "
"turn pages either way."
msgstr ""
"Kairysis spustelėjimas puslapyje pereina į kitą. Spustelėjimai su SHIFT ar "
"ALT verčia puslapius bet kuriuo atveju."

#: mcomix/preferences_dialog.py:244
msgid "A click on the left half turns back"
msgstr "Spustelėjimas kairėje pusėje verčia atgal"

#: mcomix/preferences_dialog.py:246
msgid ""
"With \"Flip pages with a left click\", the left half of the page turns back "
"and the right half forward. In manga mode it is the other way round."
msgstr ""
"Su „Versti puslapius kairiuoju spustelėjimu“ kairė puslapio pusė verčia "
"atgal, o dešinė – pirmyn. Mangos veiksenoje – atvirkščiai."

#: mcomix/preferences_dialog.py:249
msgid "Skip pages that cannot be shown"
msgstr "Praleisti puslapius, kurių negalima parodyti"

#: mcomix/preferences_dialog.py:251
msgid ""
"Turn past a page whose image is damaged or cannot be read, instead of "
"showing the broken-image icon in its place."
msgstr ""
"Praleisti puslapį, kurio paveikslėlis sugadintas arba neperskaitomas, užuot "
"jo vietoje rodžius sugadinto paveikslėlio piktogramą."

#: mcomix/preferences_dialog.py:253
msgid "Number of pixels to scroll per arrow key press:"
msgstr "Pikselių skaičius vienam rodyklės klavišo paspaudimui:"

#: mcomix/preferences_dialog.py:257
msgid "Set the number of pixels to scroll on a page when using the arrow keys."
msgstr "Nustato, kiek pikselių puslapis paslenka naudojant rodyklių klavišus."

#: mcomix/preferences_dialog.py:259
msgid "Number of pixels to scroll per mouse wheel turn:"
msgstr "Pikselių skaičius vienam pelės ratuko pasukimui:"

#: mcomix/preferences_dialog.py:263
msgid "Set the number of pixels to scroll on a page when using a mouse wheel."
msgstr "Nustato, kiek pikselių puslapis paslenka naudojant pelės ratuką."

#: mcomix/preferences_dialog.py:265
msgid "Fraction of page to scroll per space key press (in percent):"
msgstr ""
"Puslapio dalis, paslenkama vienu tarpo klavišo paspaudimu (procentais):"

#: mcomix/preferences_dialog.py:270
msgid ""
"Sets the percentage by which the page will be scrolled down or up when the "
"space key is pressed."
msgstr ""
"Nustato, kiek procentų puslapis paslenka žemyn ar aukštyn paspaudus tarpo "
"klavišą."

#: mcomix/preferences_dialog.py:273
msgid "Number of \"steps\" to take before flipping the page:"
msgstr "„Žingsnių“ skaičius prieš verčiant puslapį:"

#: mcomix/preferences_dialog.py:277
msgid ""
"Set the number of \"steps\" needed to flip to the next or previous page.  "
"Less steps will allow for very fast page turning but you might find yourself "
"accidentally turning pages."
msgstr ""
"Nustato, kiek „žingsnių“ reikia pereiti į kitą ar ankstesnį puslapį. Su "
"mažiau žingsnių versti galima labai greitai, bet lengviau tai padaryti "
"netyčia."

#: mcomix/preferences_dialog.py:280
msgid "Count the steps also when the page fits"
msgstr "Skaičiuoti žingsnius ir kai puslapis telpa"

#: mcomix/preferences_dialog.py:282
msgid ""
"A page that fits the window turns on the first step past it. With this, it "
"takes as many steps as above."
msgstr ""
"Lange telpantis puslapis verčiamas pirmu žingsniu už jo. Su šia parinktimi "
"reikia tiek žingsnių, kiek nurodyta aukščiau."

#: mcomix/preferences_dialog.py:284
msgid "Milliseconds to ignore the wheel after it turns a page:"
msgstr "Milisekundės, kurias ratukas nepaisomas apvertus puslapį:"

#: mcomix/preferences_dialog.py:288
msgid ""
"Keeps a fast wheel from turning several pages at once. 0 ignores nothing."
msgstr ""
"Neleidžia greitam ratukui apversti kelių puslapių iš karto. 0 nieko nepaiso."

#: mcomix/preferences_dialog.py:290
msgid "Between books"
msgstr "Tarp knygų"

#: mcomix/preferences_dialog.py:293
msgid "Automatically open the next archive"
msgstr "Automatiškai atverti kitą archyvą"

#: mcomix/preferences_dialog.py:295
msgid ""
"Automatically open the next archive in the directory when flipping past the "
"last page, or the previous archive when flipping past the first page."
msgstr ""
"Automatiškai atveria kitą aplanko archyvą, kai pereinama už paskutinio "
"puslapio, arba ankstesnį archyvą, kai grįžtama prieš pirmą puslapį."

#: mcomix/preferences_dialog.py:298
msgid "Automatically open next directory"
msgstr "Automatiškai atverti sekantį aplanką"

#: mcomix/preferences_dialog.py:300
msgid ""
"Automatically open the first file in the next sibling directory when "
"flipping past the last page of the last file in a directory, or the previous "
"directory when flipping past the first page of the first file."
msgstr ""
"Automatiškai atveria pirmą kito gretimo aplanko failą, kai pereinama už "
"paskutinio aplanko failo paskutinio puslapio, arba ankstesnį aplanką, kai "
"grįžtama prieš pirmo failo pirmą puslapį."

#: mcomix/preferences_dialog.py:303
msgid "Open first file when navigating to previous archive"
msgstr "Pereinant į ankstesnį archyvą atverti pirmą failą"

#: mcomix/preferences_dialog.py:305
msgid ""
"Automatically open the first file of the previous archive when navigating to "
"it, instead of opening the last file of the previous archive."
msgstr ""
"Pereinant į ankstesnį archyvą automatiškai atveria jo pirmą, o ne paskutinį "
"failą."

#: mcomix/preferences_dialog.py:308
msgid "Open first file when navigating to previous directory"
msgstr "Pereinant į ankstesnį aplanką atverti pirmą failą"

#: mcomix/preferences_dialog.py:310
msgid ""
"Automatically open the first file of the previous directory when navigating "
"to it, instead of opening the last file of the previous directory."
msgstr ""
"Pereinant į ankstesnį aplanką automatiškai atveria jo pirmą, o ne paskutinį "
"failą."

#: mcomix/preferences_dialog.py:312
msgid "File order"
msgstr "Failų tvarka"

#: mcomix/preferences_dialog.py:314
msgid "Sort files and directories by:"
msgstr "Rikiuoti failus ir aplankus pagal:"

#: mcomix/preferences_dialog.py:317
msgid "Sort archives by:"
msgstr "Rikiuoti archyvus pagal:"

#: mcomix/preferences_dialog.py:331
msgid "Use fullscreen by default"
msgstr "Pagal numatymą naudoti visą ekraną"

#: mcomix/preferences_dialog.py:335
msgid "Automatically hide all toolbars in fullscreen"
msgstr "Viso ekrano veiksenoje automatiškai slėpti visas juostas"

#: mcomix/preferences_dialog.py:339
msgid "Show the page number in fullscreen"
msgstr "Viso ekrano veiksenoje rodyti puslapio numerį"

#: mcomix/preferences_dialog.py:341
msgid "The pages on screen and the number of pages, in the lower right corner."
msgstr ""
"Ekrane rodomi puslapiai ir puslapių skaičius, apatiniame dešiniajame kampe."

#: mcomix/preferences_dialog.py:346
msgid "Flip two pages in double page mode"
msgstr "Dviejų puslapių veiksenoje versti po du puslapius"

#: mcomix/preferences_dialog.py:348
msgid ""
"Flip two pages, instead of one, each time we flip pages in double page mode."
msgstr ""
"Dviejų puslapių veiksenoje kaskart versti po du puslapius, o ne po vieną."

#: mcomix/preferences_dialog.py:350
msgid "Show only one page where appropriate:"
msgstr "Rodyti tik vieną puslapį ten, kur tinka:"

#: mcomix/preferences_dialog.py:353
msgid "Page auto-resizing:"
msgstr "Automatinis puslapių dydžio keitimas:"

#: mcomix/preferences_dialog.py:356
msgid "Space between two pages (in pixels):"
msgstr "Tarpas tarp dviejų puslapių (pikseliais):"

#: mcomix/preferences_dialog.py:361 mcomix/ui.py:541
msgid "Fit to size mode"
msgstr "Talpinimo pagal dydį veiksena"

#: mcomix/preferences_dialog.py:363
msgid "Fixed width for wide pages:"
msgstr "Pastovus plotis plačiems puslapiams:"

#: mcomix/preferences_dialog.py:368
msgid "Fixed height for wide pages:"
msgstr "Pastovus aukštis plačiems puslapiams:"

#: mcomix/preferences_dialog.py:373
msgid "Fixed width for other pages:"
msgstr "Pastovus plotis kitiems puslapiams:"

#: mcomix/preferences_dialog.py:378
msgid "Fixed height for other pages:"
msgstr "Pastovus aukštis kitiems puslapiams:"

#: mcomix/preferences_dialog.py:383
msgid "Slideshow"
msgstr "Skaidrių rodymas"

#: mcomix/preferences_dialog.py:385
msgid "Slideshow delay (in seconds):"
msgstr "Skaidrių rodymo delsa (sekundėmis):"

#: mcomix/preferences_dialog.py:390
msgid "Slideshow step (in pixels):"
msgstr "Skaidrių rodymo žingsnis (pikseliais):"

#: mcomix/preferences_dialog.py:394
msgid ""
"Specify the number of pixels to scroll while in slideshow mode. A positive "
"value will scroll forward, a negative value will scroll backwards, and a "
"value of 0 will cause the slideshow to always flip to a new page."
msgstr ""
"Nurodo, kiek pikselių paslenkama skaidrių rodymo veiksenoje. Teigiama "
"reikšmė slenka pirmyn, neigiama atgal, o reikšmė 0 verčia rodymą visada "
"pereiti į naują puslapį."

#: mcomix/preferences_dialog.py:397
msgid "During a slideshow automatically open the next archive"
msgstr "Rodant skaidres automatiškai atverti kitą archyvą"

#: mcomix/preferences_dialog.py:399
msgid ""
"While in slideshow mode allow the next archive to automatically be opened."
msgstr "Leidžia skaidrių rodymo veiksenoje automatiškai atverti kitą archyvą."

#: mcomix/preferences_dialog.py:401
msgid "Rotation"
msgstr "Pasukimas"

#: mcomix/preferences_dialog.py:404
msgid "Automatically rotate images according to their metadata"
msgstr "Automatiškai sukti paveikslėlius pagal jų metaduomenis"

#: mcomix/preferences_dialog.py:406
msgid ""
"Automatically rotate images when an orientation is specified in the image "
"metadata, such as in an Exif tag."
msgstr ""
"Automatiškai pasuka paveikslėlius, kai jų metaduomenyse nurodyta "
"orientacija, pavyzdžiui Exif žymoje."

#: mcomix/preferences_dialog.py:408
msgid "Image quality"
msgstr "Paveikslėlio kokybė"

#: mcomix/preferences_dialog.py:410
msgid "Scaling mode"
msgstr "Mastelio keitimo veiksena"

#: mcomix/preferences_dialog.py:422
msgid "Extraction and cache"
msgstr "Išpakavimas ir podėlis"

#: mcomix/preferences_dialog.py:430
msgid "Maximum number of concurrent extraction threads:"
msgstr "Didžiausias lygiagrečių išpakavimo gijų skaičius:"

#: mcomix/preferences_dialog.py:434
msgid ""
"Set the maximum number of concurrent threads for formats that support it. A "
"value of 0 uses one thread for each processor. For PDFs, 0 also keeps within "
"a sixteenth of the memory."
msgstr ""
"Nustato didžiausią lygiagrečių gijų skaičių tai palaikantiems formatams. "
"Reikšmė 0 kiekvienam procesoriui naudoja po vieną giją. PDF failams 0 taip "
"pat neviršija šešioliktosios atminties dalies."

#: mcomix/preferences_dialog.py:436
msgid "Maximum number of concurrent thumbnail threads:"
msgstr "Didžiausias lygiagrečių miniatiūrų gijų skaičius:"

#: mcomix/preferences_dialog.py:440
msgid ""
"Set the maximum number of concurrent threads used to generate thumbnails. A "
"value of 0 uses one thread for each processor. Takes effect the next time "
"MComix is started."
msgstr ""
"Nustato didžiausią lygiagrečių gijų skaičių miniatiūroms kurti. Reikšmė 0 "
"kiekvienam procesoriui naudoja po vieną giją. Įsigalioja kitą kartą paleidus "
"MComix."

#: mcomix/preferences_dialog.py:443
msgid "Store thumbnails for opened files"
msgstr "Saugoti atvertų failų miniatiūras"

#: mcomix/preferences_dialog.py:445
msgid ""
"Store thumbnails for opened files according to the freedesktop.org "
"specification. These thumbnails are shared by many other applications, such "
"as most file managers."
msgstr ""
"Saugoti atvertų failų miniatiūras pagal freedesktop.org specifikaciją. "
"Šiomis miniatiūromis naudojasi daugelis kitų programų, pavyzdžiui dauguma "
"failų tvarkyklių."

#: mcomix/preferences_dialog.py:447
msgid "Maximum number of pages to store in the cache:"
msgstr "Didžiausias podėlyje saugomų puslapių skaičius:"

#: mcomix/preferences_dialog.py:451
msgid ""
"Set the max number of pages to cache. A value of -1 will cache the entire "
"archive."
msgstr ""
"Nustato didžiausią podėlyje saugomų puslapių skaičių. Reikšmė -1 saugo visą "
"archyvą."

#: mcomix/preferences_dialog.py:453
msgid "Magnifying Lens"
msgstr "Didinamasis stiklas"

#: mcomix/preferences_dialog.py:455
msgid "Magnifying lens size (in pixels):"
msgstr "Didinamojo stiklo dydis (pikseliais):"

#: mcomix/preferences_dialog.py:459
msgid ""
"Set the size of the magnifying lens. It is a square with a side of this many "
"pixels."
msgstr ""
"Nustato didinamojo stiklo dydį. Tai kvadratas, kurio kraštinė yra tiek "
"pikselių."

#: mcomix/preferences_dialog.py:461
msgid "Magnification factor:"
msgstr "Didinimo koeficientas:"

#: mcomix/preferences_dialog.py:465
msgid "Set the magnification factor of the magnifying lens."
msgstr "Nustato didinamojo stiklo didinimo koeficientą."

#: mcomix/preferences_dialog.py:469
msgid "Comment extensions:"
msgstr "Komentarų failų galūnės:"

#: mcomix/preferences_dialog.py:472
msgid "Animated images"
msgstr "Animuoti paveikslėliai"

#: mcomix/preferences_dialog.py:474
msgid "Animation mode:"
msgstr "Animacijos veiksena:"

#: mcomix/preferences_dialog.py:495
msgid "_Reset keys"
msgstr "A_tstatyti klavišus"

#: mcomix/preferences_dialog.py:497
msgid "Resets all keyboard shortcuts to their default values."
msgstr ""
"Atstato visas sparčiąsias klavišų kombinacijas į numatytąsias reikšmes."

#: mcomix/preferences_dialog.py:500
msgid "Clear _dialog choices"
msgstr "_Išvalyti dialogų pasirinkimus"

#: mcomix/preferences_dialog.py:502
msgid ""
"Clears all dialog choices that you have previously chosen not to be asked "
"again."
msgstr ""
"Išvalo visus dialogų atsakymus, apie kuriuos anksčiau pasirinkote daugiau "
"neklausti."

#: mcomix/preferences_dialog.py:537
msgid "Ask every time"
msgstr "Klausti kaskart"

#: mcomix/preferences_dialog.py:542
msgid ""
"What MComix answers this prompt with instead of asking. This is what the "
"prompt's \"Do not ask again\" box sets."
msgstr ""
"Atsakymas, kurį MComix pateikia į šį klausimą, užuot jį uždavęs. Būtent tai "
"nustato paties klausimo langelis „Daugiau neklausti.“."

#: mcomix/preferences_dialog.py:564
msgid "Auto-detect (Default)"
msgstr "Nustatyti automatiškai (numatytoji)"

#: mcomix/preferences_dialog.py:606
msgid "Follow the system"
msgstr "Sekti sistema"

#: mcomix/preferences_dialog.py:607
msgid "Light"
msgstr "Šviesi"

#: mcomix/preferences_dialog.py:608
msgid "Dark"
msgstr "Tamsi"

#: mcomix/preferences_dialog.py:609
msgid "Pitch black"
msgstr "Visiškai juoda"

#: mcomix/preferences_dialog.py:615
msgid ""
"How MComix itself is painted, whatever the desktop asks for. Pitch black is "
"the dark theme with black backgrounds, which a screen that lights its pixels "
"one by one shows as no light at all."
msgstr ""
"Kaip piešiamas pats MComix, nepaisant darbalaukio nuostatų. Visiškai juoda "
"yra tamsi tema juodu fonu, kurią pikselius po vieną uždegantis ekranas rodo "
"kaip visišką šviesos nebuvimą."

#: mcomix/preferences_dialog.py:652
msgid "Restart MComix in the language you picked?"
msgstr "Paleisti „MComix“ iš naujo pasirinkta kalba?"

#: mcomix/preferences_dialog.py:653
msgid ""
"MComix is translated as it starts, so most of the interface stays in the "
"language it started in until it is started again. The book being read, its "
"page and the window size are kept."
msgstr ""
"„MComix“ išverčiama paleidimo metu, todėl didžioji sąsajos dalis lieka ta "
"kalba, kuria buvo paleista, kol programa nepaleidžiama iš naujo. Skaitoma "
"knyga, jos puslapis ir lango dydis išsaugomi."

#: mcomix/preferences_dialog.py:667 mcomix/preferences_dialog.py:816
#: mcomix/preferences_dialog.py:881 mcomix/ui.py:547
msgid "Never"
msgstr "Niekada"

#: mcomix/preferences_dialog.py:668
msgid "Only for title pages"
msgstr "Tik antraštiniams puslapiams"

#: mcomix/preferences_dialog.py:669
msgid "Only for wide images"
msgstr "Tik platiems paveikslėliams"

#: mcomix/preferences_dialog.py:670 mcomix/preferences_dialog.py:817
msgid "Always"
msgstr "Visada"

#: mcomix/preferences_dialog.py:677
msgid ""
"When showing the first page of an archive, or an image's width exceeds its "
"height, only a single page will be displayed."
msgstr ""
"Rodant pirmą archyvo puslapį arba kai paveikslėlio plotis viršija jo aukštį, "
"rodomas tik vienas puslapis."

#: mcomix/preferences_dialog.py:695
msgid "Prefer same scale"
msgstr "Pirmenybė tam pačiam masteliui"

