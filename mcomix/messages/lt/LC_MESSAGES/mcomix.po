msgstr "Prieitas"

#: mcomix/properties_dialog.py:264
msgid "Modified"
msgstr "Modifikuota"

#: mcomix/properties_dialog.py:273
msgid "Permissions"
msgstr "Leidimai"

#: mcomix/properties_dialog.py:274
